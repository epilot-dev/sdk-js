`SessionErrorCode`](#sessionerrorcode)\n- [`ContextBreakdown`](#contextbreakdown)\n- [`BatchChange`](#batchchange)\n- [`ChangeOutcome`](#changeoutcome)\n- [`Question`](#question)\n- [`Answer`](#answer)\n- [`ClientEvent`](#clientevent)\n- [`ClientEventBase`](#clienteventbase)\n- [`ClientEventInput`](#clienteventinput)\n- [`ClientEventInputTaken`](#clienteventinputtaken)\n- [`ClientEventInputCancelled`](#clienteventinputcancelled)\n- [`ClientEventInputFailed`](#clienteventinputfailed)\n- [`ClientEventTurnStarted`](#clienteventturnstarted)\n- [`ClientEventModelUsage`](#clienteventmodelusage)\n- [`ClientEventContextCompacted`](#clienteventcontextcompacted)\n- [`ClientEventTurnEnded`](#clienteventturnended)\n- [`ClientEventMessage`](#clienteventmessage)\n- [`ClientEventStepStarted`](#clienteventstepstarted)\n- [`ClientEventStepFinished`](#clienteventstepfinished)\n- [`ClientEventSkillLoaded`](#clienteventskillloaded)\n- [`ClientEventApprovalRequired`](#clienteventapprovalrequired)\n- [`ClientEventApprovalResolved`](#clienteventapprovalresolved)\n- [`ClientEventApprovalExecuted`](#clienteventapprovalexecuted)\n- [`ClientEventApprovalResult`](#clienteventapprovalresult)\n- [`ClientEventQuestionAsked`](#clienteventquestionasked)\n- [`ClientEventFilesCreated`](#clienteventfilescreated)\n- [`ClientEventQuestionAnswered`](#clienteventquestionanswered)\n\n### `createAgent`\n\nCreate Agent definition\n\n`POST /v1/agents`\n\n```ts\nconst { data } = await client.createAgent(\n  null,\n  {\n    domain: 'customer_service',\n    availability: ['flows'],\n    name: 'Email Reply Generator',\n    description: 'string',\n    category: 'message',\n    icon: 'mail-reply',\n    system_prompt: 'string',\n    tools: ['entity.search', 'message.draft'],\n    model_config: {\n      model_id: 'anthropic.claude-3-5-sonnet-20241022-v2:0',\n      temperature: 0.7,\n      max_tokens: 4096,\n      thinking: false,\n      thinking_budget: 10000\n    },\n    max_iterations: 10,\n    execution_pattern: 'direct',\n    execution_mode: 'automatic',\n    output_schema: {},\n    input_parameters_schema: {\n      type: 'object',\n      parameters: [\n        {\n          name: 'target_schema',\n          label: 'Target Schema',\n          type: 'entity-schema',\n          description: 'Entity type to create'\n        },\n        {\n          name: 'confidence_threshold',\n          label: 'Confidence Threshold',\n          type: 'number',\n          minimum: 0,\n          maximum: 1,\n          default: 0.8\n        },\n        /* ... 1 more */\n      ],\n      required: ['target_schema']\n    },\n    knowledge_source_ids: ['3fa85f64-5717-4562-b3fc-2c963f66afa6']\n  },\n)\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"domain\": \"customer_service\",\n  \"agent_id\": \"skill:email-categorizer\",\n  \"org_id\": \"string\",\n  \"name\": \"string\",\n  \"description\": \"string\",\n  \"category\": \"message\",\n  \"icon\": \"string\",\n  \"source\": \"system\",\n  \"availability\": [\"flows\", \"copilot\"],\n  \"allowed_entity_schemas\": [\"message\"],\n  \"system_prompt\": \"string\",\n  \"tools\": [\"string\"],\n  \"model_config\": {\n    \"model_id\": \"anthropic.claude-3-5-sonnet-20241022-v2:0\",\n    \"temperature\": 0.7,\n    \"max_tokens\": 4096,\n    \"thinking\": false,\n    \"thinking_budget\": 10000\n  },\n  \"max_iterations\": 0,\n  \"execution_pattern\": \"direct\",\n  \"execution_mode\": \"automatic\",\n  \"output_schema\": {},\n  \"input_parameters_schema\": {\n    \"type\": \"object\",\n    \"parameters\": [\n      {\n        \"name\": \"target_schema\",\n        \"label\": \"Target Schema\",\n        \"type\": \"entity-schema\",\n        \"description\": \"Entity type to create\"\n      },\n      {\n        \"name\": \"confidence_threshold\",\n        \"label\": \"Confidence Threshold\",\n        \"type\": \"number\",\n        \"minimum\": 0,\n        \"maximum\": 1,\n        \"default\": 0.8\n      }\n    ],\n    \"required\": [\"target_schema\"]\n  },\n  \"knowledge_source_ids\": [\"3fa85f64-5717-4562-b3fc-2c963f66afa6\"],\n  \"version\": 0,\n  \"created_at\": \"1970-01-01T00:00:00.000Z\",\n  \"updated_at\": \"1970-01-01T00:00:00.000Z\",\n  \"created_by\": \"string\"\n}\n```\n\n</details>\n\n---\n\n### `listAgents`\n\nList all agent configurations\n\n`GET /v1/agents`\n\n```ts\nconst { data } = await client.listAgents({\n  source: 'example',\n  availability: 'example',\n  entity_schema: 'example',\n})\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"agents\": [\n    {\n      \"domain\": \"customer_service\",\n      \"agent_id\": \"skill:email-categorizer\",\n      \"org_id\": \"string\",\n      \"name\": \"string\",\n      \"description\": \"string\",\n      \"category\": \"message\",\n      \"icon\": \"string\",\n      \"source\": \"system\",\n      \"availability\": [\"flows\", \"copilot\"],\n      \"allowed_entity_schemas\": [\"message\"],\n      \"system_prompt\": \"string\",\n      \"tools\": [\"string\"],\n      \"model_config\": {\n        \"model_id\": \"anthropic.claude-3-5-sonnet-20241022-v2:0\",\n        \"temperature\": 0.7,\n        \"max_tokens\": 4096,\n        \"thinking\": false,\n        \"thinking_budget\": 10000\n      },\n      \"max_iterations\": 0,\n      \"execution_pattern\": \"direct\",\n      \"execution_mode\": \"automatic\",\n      \"output_schema\": {},\n      \"input_parameters_schema\": {\n        \"type\": \"object\",\n        \"parameters\": [\n          {\n            \"name\": \"target_schema\",\n            \"label\": \"Target Schema\",\n            \"type\": \"entity-schema\",\n            \"description\": \"Entity type to create\"\n          },\n          {\n            \"name\": \"confidence_threshold\",\n            \"label\": \"Confidence Threshold\",\n            \"type\": \"number\",\n            \"minimum\": 0,\n            \"maximum\": 1,\n            \"default\": 0.8\n          }\n        ],\n        \"required\": [\"target_schema\"]\n      },\n      \"knowledge_source_ids\": [\"3fa85f64-5717-4562-b3fc-2c963f66afa6\"],\n      \"version\": 0,\n      \"created_at\": \"1970-01-01T00:00:00.000Z\",\n      \"updated_at\": \"1970-01-01T00:00:00.000Z\",\n      \"created_by\": \"string\"\n    }\n  ],\n  \"next_cursor\": \"string\"\n}\n```\n\n</details>\n\n---\n\n### `getAgentById`\n\nGet the agent configuration by ID\n\n`GET /v1/agents/{agent_id}`\n\n```ts\nconst { data } = await client.getAgentById({\n  agent_id: 'example',\n})\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"domain\": \"customer_service\",\n  \"agent_id\": \"skill:email-categorizer\",\n  \"org_id\": \"string\",\n  \"name\": \"string\",\n  \"description\": \"string\",\n  \"category\": \"message\",\n  \"icon\": \"string\",\n  \"source\": \"system\",\n  \"availability\": [\"flows\", \"copilot\"],\n  \"allowed_entity_schemas\": [\"message\"],\n  \"system_prompt\": \"string\",\n  \"tools\": [\"string\"],\n  \"model_config\": {\n    \"model_id\": \"anthropic.claude-3-5-sonnet-20241022-v2:0\",\n    \"temperature\": 0.7,\n    \"max_tokens\": 4096,\n    \"thinking\": false,\n    \"thinking_budget\": 10000\n  },\n  \"max_iterations\": 0,\n  \"execution_pattern\": \"direct\",\n  \"execution_mode\": \"automatic\",\n  \"output_schema\": {},\n  \"input_parameters_schema\": {\n    \"type\": \"object\",\n    \"parameters\": [\n      {\n        \"name\": \"target_schema\",\n        \"label\": \"Target Schema\",\n        \"type\": \"entity-schema\",\n        \"description\": \"Entity type to create\"\n      },\n      {\n        \"name\": \"confidence_threshold\",\n        \"label\": \"Confidence Threshold\",\n        \"type\": \"number\",\n        \"minimum\": 0,\n        \"maximum\": 1,\n        \"default\": 0.8\n      }\n    ],\n    \"required\": [\"target_schema\"]\n  },\n  \"knowledge_source_ids\": [\"3fa85f64-5717-4562-b3fc-2c963f66afa6\"],\n  \"version\": 0,\n  \"created_at\": \"1970-01-01T00:00:00.000Z\",\n  \"updated_at\": \"1970-