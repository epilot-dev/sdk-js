"createdAt\": \"1970-01-01T00:00:00.000Z\",\n    \"updatedAt\": \"1970-01-01T00:00:00.000Z\",\n    \"status\": \"idle\",\n    \"live\": {\n      \"transport\": \"appsync\",\n      \"httpHost\": \"string\",\n      \"realtimeUrl\": \"string\",\n      \"channel\": \"string\"\n    }\n  }\n}\n```\n\n</details>\n\n---\n\n### `renameSession`\n\nRename a session\n\n`PATCH /v2/sessions/{sessionId}`\n\n```ts\nconst { data } = await client.renameSession(\n  {\n    sessionId: 'example',\n  },\n  {\n    title: 'string'\n  },\n)\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"session\": {\n    \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"agentId\": \"string\",\n    \"mode\": \"read\",\n    \"title\": \"string\",\n    \"origin\": \"string\",\n    \"createdAt\": \"1970-01-01T00:00:00.000Z\",\n    \"updatedAt\": \"1970-01-01T00:00:00.000Z\",\n    \"status\": \"idle\",\n    \"live\": {\n      \"transport\": \"appsync\",\n      \"httpHost\": \"string\",\n      \"realtimeUrl\": \"string\",\n      \"channel\": \"string\"\n    }\n  }\n}\n```\n\n</details>\n\n---\n\n### `deleteSession`\n\nDelete a session\n\n`DELETE /v2/sessions/{sessionId}`\n\n```ts\nconst { data } = await client.deleteSession({\n  sessionId: 'example',\n})\n```\n\n---\n\n### `listSessionEvents`\n\nList a session's events\n\n`GET /v2/sessions/{sessionId}/events`\n\n```ts\nconst { data } = await client.listSessionEvents({\n  sessionId: 'example',\n  after: 1,\n  limit: 1,\n})\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"events\": [\n    {\n      \"seq\": 0,\n      \"eventId\": \"string\",\n      \"occurredAt\": \"1970-01-01T00:00:00.000Z\",\n      \"blocked\": true,\n      \"inputEventId\": \"string\",\n      \"type\": \"input\",\n      \"input\": {\n        \"kind\": \"message\",\n        \"text\": \"string\",\n        \"files\": [\n          {\n            \"fileId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n            \"name\": \"string\",\n            \"mediaType\": \"string\",\n            \"size\": 0\n          }\n        ]\n      }\n    }\n  ],\n  \"lastSeq\": 0,\n  \"hasMore\": true,\n  \"status\": \"idle\"\n}\n```\n\n</details>\n\n---\n\n### `sendSessionEvent`\n\nSend to a session\n\n`POST /v2/sessions/{sessionId}/events`\n\n```ts\nconst { data } = await client.sendSessionEvent(\n  {\n    sessionId: 'example',\n  },\n  {\n    text: '',\n    context: {},\n    files: ['3fa85f64-5717-4562-b3fc-2c963f66afa6'],\n    type: 'user.message',\n    requestId: '3fa85f64-5717-4562-b3fc-2c963f66afa6'\n  },\n)\n```\n\n---\n\n### `getSessionFileUrl`\n\nGet a link to a session file\n\n`GET /v2/sessions/{sessionId}/files/{fileId}`\n\n```ts\nconst { data } = await client.getSessionFileUrl({\n  sessionId: 'example',\n  fileId: 'example',\n  download: 'example',\n})\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"url\": \"string\",\n  \"expiresAt\": \"1970-01-01T00:00:00.000Z\"\n}\n```\n\n</details>\n\n---\n\n### `runScript`\n\nRun a script\n\n`POST /v2/sessions/scripts`\n\n```ts\nconst { data } = await client.runScript(\n  null,\n  {\n    language: 'javascript',\n    script: 'string',\n    description: 'string',\n    waitMs: 0\n  },\n)\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"runId\": \"string\",\n  \"status\": \"running\",\n  \"output\": \"string\",\n  \"changes\": 0\n}\n```\n\n</details>\n\n---\n\n### `getScriptRun`\n\nGet a script run\n\n`GET /v2/sessions/scripts/{runId}`\n\n```ts\nconst { data } = await client.getScriptRun({\n  runId: 'example',\n  waitMs: 1,\n})\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"runId\": \"string\",\n  \"status\": \"running\",\n  \"output\": \"string\",\n  \"changes\": 0\n}\n```\n\n</details>\n\n---\n\n### `applyScriptRun`\n\nApply a script run's changes\n\n`POST /v2/sessions/scripts/{runId}/apply`\n\n```ts\nconst { data } = await client.applyScriptRun(\n  {\n    runId: 'example',\n  },\n  {\n    approvalSummary: 'string'\n  },\n)\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"done\": true,\n  \"applied\": 0,\n  \"total\": 0,\n  \"result\": {\n    \"content\": [\n      {\n        \"type\": \"text\",\n        \"text\": \"string\"\n      }\n    ],\n    \"isError\": true\n  }\n}\n```\n\n</details>\n\n---\n\n### `revokeSessionAgents`\n\nRevoke the caller's session agents\n\n`POST /v2/agents/revoke`\n\n```ts\nconst { data } = await client.revokeSessionAgents()\n```\n\n---\n\n### `createInternalSession`\n\nStart an unattended session (services only)\n\n`POST /v2/internal/sessions`\n\n```ts\nconst { data } = await client.createInternalSession(\n  null,\n  {\n    agentId: 'string',\n    origin: 'configuration-hub',\n    owner: {\n      user_id: 'string'\n    },\n    unattended: true,\n    client_token: 'string',\n    input: {\n      text: 'string',\n      context: {\n        intent: 'blueprint-tests.suggest'\n      }\n    }\n  },\n)\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"unattended_access\": true\n}\n```\n\n</details>\n\n---\n\n### `getInternalSession`\n\nWhat an unattended session is doing (services only)\n\n`GET /v2/internal/sessions/{sessionId}`\n\n```ts\nconst { data } = await client.getInternalSession({\n  sessionId: 'example',\n})\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"state\": \"working\",\n  \"needs\": \"first_message\",\n  \"attended\": true,\n  \"last_activity_at\": \"1970-01-01T00:00:00.000Z\",\n  \"turns\": 0\n}\n```\n\n</details>\n\n---\n\n### `createInternalExecution`\n\nStart a Flows execution as a background run (services only)\n\n`POST /v2/internal/executions`\n\n```ts\nconst { data } = await client.createInternalExecution(\n  null,\n  {\n    execution_id: 'string',\n    agent_id: 'string',\n    input: {\n      text: 'string',\n      context: {}\n    },\n    mode: 'automatic',\n    skill: {\n      instructions: 'string',\n      tools: ['string'],\n      output_schema: {}\n    },\n    parameters: {},\n    flows: {\n      workflow_id: 'string',\n      workflow_name: 'string',\n      workflow_execution_id: 'string',\n      task_id: 'string'\n    }\n  },\n)\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"session_id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\"\n}\n```\n\n</details>\n\n---\n\n### `decideInternalExecution`\n\nDecide what a Flows run on v2 waits for (services only)\n\n`POST /v2/internal/executions/{executionId}/decision`\n\n```ts\nconst { data } = await client.decideInternalExecution(\n  {\n    executionId: 'example',\n  },\n  {\n    approval_id: 'string',\n    approved: true,\n    reason: 'string',\n    decided_by: 'string'\n  },\n)\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"approval\": {\n    \"id\": \"string\",\n    \"status\": \"string\"\n  }\n}\n```\n\n</details>\n\n---\n\n### `listInternalPortalChats`\n\nAn agent's portal chats on v2, for Agent Builder's history (services only)\n\n`GET /v2/internal/portal-chats`\n\n```ts\nconst { data } = await client.listInternalPortalChats({\n  agent_id: 'example',\n  limit: 1,\n  after_updated_at: 'example',\n  after_id: 'example',\n  from: 'example',\n  to: 'example',\n  has_ticket: true,\n  ids: 'example',\n})\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"conversations\": [\n    {\n      \"conversation_id\": \"string\",\n      \"updated_at\": \"1970-01-01T00:00:00.000Z\"\n    }\n  ],\n  \"has_more\": true,\n  \"read_to\": {\n    \"conversation_id\": \"string\",\n    \"updated_at\": \"1970-01-01T00:00:00.000Z\"\n  }\n}\n```\n\n</details>\n\n---\n\n### `getInternalPortalChat`\n\nOne portal chat on v2 with its transcript, for Agent Builder's history (services only)\n\n`GET /v2/internal/portal-chats/{sessionId}`\n\n```ts\nconst { data } = await client.getInternalPortalChat({\n  sessionId: 'example',\n  agent_id: 'example',\n})\n```\n\n<details>\n<summary>Response</summary>\n\n```json\n{\n  \"conversation\": {\n    \"conversation_id\": \"string\",\n    \"user_id\": \"string\",\n    \"contact_id\": \"string\",\n    \"title\": \"string\",\n    \"message_count\": 0,\n    \"last_message\": \"string\",\n    \"last_message_at\": \"1970-01-01T00:00:00.000Z\",\n    \"created_at\": \"1970-01-01T00:00:00.000Z\",\n    \"ticket_ids\": [\"string\"]\n  },\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"string\",\n      \"timestamp\": \"1970-01-01T00:00:00.000Z\",\n      \"blocked\": true\n    }\n  ]\n}\n```\n\n</details>\n\n---\n\n## Schemas\n\n### `AgentConfig`\n\n```ts\ntype AgentConfig = {\n  capabilities: Array<{\n    type: \"navigate_portal_pages\" | \"search_portal_records\" | \"view_billing\" | \"view_meter_readings\" | \"view_contracts\" | \"search_web\" | \"open_quick_actions\" | \"view_hems_energy\" | \"open_journey\" | \"open_link\" | \"submit_meter_reading\"\n    instanceId?: string\n    enabled: boolean\n    meterTypes?: string[]\n    ticketType?: string\n    allowedDomains?: string[]\n    autonomy?: \"draft\" | \"approval\" | \"automatic\"\n    label?: string\n    guidance?: string\n    blockIds?: string[]\n    integrationId?: string // uuid\n    accessLevel?: \"anonymous\" | \"authenticated\"\n    intent?: \"submit_meter_reading\"\n    journeyId?: string // uuid\n    journeyName?: string\n    url?: string\n    searchDeviceDocs?: boolean\n  }>\n  knowledgeSources: Array<{\n    id: string\n    type: \"portal_page\" | \"document\" | \"catalogue\" | \"url\"\n    title: string\n    targetId: string\n    detail?: string\n  }>\n  escalation: {\n    websiteHandover: {\n      kind: { ... }\n      value: { ... }\n      journeyId?: { ... }\n      journeyName?: { ... }\n    }\n    ticketPurpose?: {\n      id: { ... }\n      name?: { ... }\n    }\n  }\n  appearance: {\n    displayName: string\n    greeting: string\n    starters: string[]\n    starterKeys?: string[]\n    launcherLabel?: string\n    language: \"de\" | \"en\"\n    formOfAddress: \"sie\" | \"du\"\n    followUps?: boolean\n    languages?: \"de\" | \"en\"[]\n    translations?: {\n      de?: { ... }\n      en?: { ... }\n    }\n    needsReview?: {\n      de?: { ... }\n      en?: { ... }\n    }\n  }\n  instructions?: string\n  instructionTranslations?: {\n    de?: string\n    en?: string\n  }\n  instructionsNeedsReview?: \"de\" | \"en\"[]\n}\n```\n\n### `AppearanceConfig`\n\n```ts\ntype AppearanceConfig = {\n  displayName: string\n  greeting: string\n  starters: string[]\n  starterKeys?: string[]\n  launcherLabel?: string\n  language: \"de\" | \"en\"\n  formOfAddress: \"sie\" | \"du\"\n  followUps?: boolean\n  languages?: \"de\" | \"en\"[]\n  translations?: {\n    de?: {\n      displayName: { ... }\n      greeting: { ... }\n      starters: { ... }\n      starterKeys?: { ... }\n      launcherLabel?: { ... }\n    }\n    en?: {\n      displayName: { ... }\n      greeting: { ... }\n      starters: { ... }\n      starterKeys?: { ... }\n      launcherLabel?: { ... }\n    }\n  }\n  needsReview?: {\n    de?: \"displayName\" | \"greeting\" | \"starters\" | \"launcherLabel\"[]\n    en?: \"displayName\" | \"greeting\" | \"starters\" | \"launcherLabel\"[]\n  }\n}\n```\n\n### `LocalizedAppearance`\n\n```ts\ntype LocalizedAppearance = {\n  displayName: string\n  greeting: string\n  starters: string[]\n  starterKeys?: string[]\n  launcherLabel?: string\n}\n```\n\n### `LocalizedFieldList`\n\n```ts\ntype LocalizedFieldList = \"displayName\" | \"greeting\" | \"starters\" | \"launcherLabel\"[]\n```\n\n### `CapabilityId`\n\n```ts\ntype CapabilityId = \"navigate_portal_pages\" | \"search_portal_records\" | \"view_billing\" | \"view_meter_readings\" | \"view_contracts\" | \"search_web\" | \"open_quick_actions\" | \"view_hems_energy\" | \"open_journey\" | \"open_link\" | \"submit_meter_reading\"\n```\n\n### `AccessLevel`\n\nWho may use a capability. `anonymous` = every visitor, `authenticated` =\nonly a customer authenticated by email code or portal login; others are\nasked to sign in first. Each capability type has a default and a\nminimum; values below the minimum are raised. Used today by\n`open_journey`, `open_link` an\n\n```ts\ntype AccessLevel = \"anonymous\" | \"authenticated\"\n```\n\n### `SelfServiceIntent`\n\nWhat a journey, link or in-chat capability is for; names the action in the chat and in analytics.\n\n```ts\ntype SelfServiceIntent = \"submit_meter_reading\"\n```\n\n### `ActionAutonomy`\n\nAction capabilities only (`open_quick_actions`): per-capability autonomy.\n`draft` = suggest only (proposal + deep link, nothing opens),\n`approval` = the customer confirms in a card first,\n`automatic` = run immediately. Defaults to `approval` when the\ncapability is enabled without one; unknown values\n\n```ts\ntype ActionAutonomy = \"draft\" | \"approval\" | \"automatic\"\n```\n\n### `CapabilityState`\n\n```ts\ntype CapabilityState = {\n  enabled: boolean\n  meterTypes?: string[]\n  ticketType?: string\n  allowedDomains?: string[]\n  autonomy?: \"draft\" | \"approval\" | \"automatic\"\n  label?: string\n  guidance?: string\n  blockIds?: string[]\n  integrationId?: string // uuid\n  accessLevel?: \"anonymous\" | \"authenticated\"\n  intent?: \"submit_meter_reading\"\n  journeyId?: string // uuid\n  journeyName?: string\n  url?: string\n  searchDeviceDocs?: boolean\n}\n```\n\n### `CapabilityInstance`\n\n```ts\ntype CapabilityInstance = {\n  type: \"navigate_portal_pages\" | \"search_portal_records\" | \"view_billing\" | \"view_meter_readings\" | \"view_contracts\" | \"search_web\" | \"open_quick_actions\" | \"view_hems_energy\" | \"open_journey\" | \"open_link\" | \"submit_meter_reading\"\n  instanceId?: string\n  enabled: boolean\n  meterTypes?: string[]\n  ticketType?: string\n  allowedDomains?: string[]\n  autonomy?: \"draft\" | \"approval\" | \"automatic\"\n  label?: string\n  guidance?: string\n  blockIds?: string[]\n  integrationId?: string // uuid\n  accessLevel?: \"anonymous\" | \"authenticated\"\n  intent?: \"submit_meter_reading\"\n  journeyId?: string // uuid\n  journeyName?: string\n  url?: string\n  searchDeviceDocs?: boolean\n}\n```\n\n### `CreateCustomerChatAgentRequest`\n\n```ts\ntype CreateCustomerChatAgentRequest = {\n  place: \"website\" | \"portal\"\n  internal_name?: string\n}\n```\n\n### `CustomerChatAgent`\n\n```ts\ntype CustomerChatAgent = {\n  org_id: string\n  agent_id: string // uuid\n  place: \"website\" | \"portal\"\n  internal_name: string\n  runtime_agent_id: string // uuid\n  config: {\n    capabilities: Array<{\n      type: { ... }\n      instanceId?: { ... }\n      enabled: { ... }\n      meterTypes?: { ... }\n      ticketType?: { ... }\n      allowedDomains?: { ... }\n      autonomy?: { ... }\n      label?: { ... }\n      guidance?: { ... }\n      blockIds?: { ... }\n      integrationId?: { ... }\n      accessLevel?: { ... }\n      intent?: { ... }\n      journeyId?: { ... }\n      journeyName?: { ... }\n      url?: { ... }\n      searchDeviceDocs?: { ... }\n    }>\n    knowledgeSources: Array<{\n      id: { ... }\n      type: { ... }\n      title: { ... }\n      targetId: { ... }\n      detail?: { ... }\n    }>\n    escalation: {\n      websiteHandover: { ... }\n      ticketPurpose?: { ... }\n    }\n    appearance: {\n      displayName: { ... }\n      greeting: { ... }\n      starters: { ... }\n      starterKeys?: { ... }\n      launcherLabel?: { ... }\n      language: { ... }\n      formOfAddress: { ... }\n      followUps?: { ... }\n      languages?: { ... }\n      translations?: { ... }\n      needsReview?: { ... }\n    }\n    instructions?: string\n    instructionTranslations?: {\n      de?: { ... }\n      en?: { ... }\n    }\n    instructionsNeedsReview?: \"de\" | \"en\"[]\n  }\n  created_at: string // date-time\n  updated_at: string // date-time\n}\n```\n\n### `CustomerChatCasRequest`\n\n```ts\ntype CustomerChatCasRequest = {\n  updated_at?: string // date-time\n}\n```\n\n### `DeleteCustomerChatAgentRequest`\n\n```ts\ntype DeleteCustomerChatAgentRequest = {\n  updated_at?: string // date-time\n  portal_id?: string // uuid\n}\n```\n\n### `CustomerChatPlace`\n\n```ts\ntype CustomerChatPlace = \"website\" | \"portal\"\n```\n\n### `EscalationConfig`\n\n```ts\ntype EscalationConfig = {\n  websiteHandover: {\n    kind: \"phone\" | \"email\" | \"journey\" | \"ticket\" | \"unset\"\n    value: string\n    journeyId?: string\n    journeyName?: string\n  }\n  ticketPurpose?: {\n    id: string\n    name?: string\n  }\n}\n```\n\n### `TicketPurpose`\n\nPortal places only: purpose set on tickets the portal chat creates when\nit hands over to the service team. Omit (or send `null`) for a plain ticket.\n\n\n```ts\ntype TicketPurpose = {\n  id: string\n  name?: string\n}\n```\n\n### `CustomerChatKnowledgeSource`\n\n```ts\ntype CustomerChatKnowledgeSource = {\n  id: string\n  type: \"portal_page\" | \"document\" | \"catalogue\" | \"url\"\n  title: string\n  targetId: string\n  detail?: string\n}\n```\n\n### `CustomerChatKnowledgeSourceType`\n\n```ts\ntype CustomerChatKnowledgeSourceType = \"portal_page\" | \"document\" | \"catalogue\" | \"url\"\n```\n\n### `ListCustomerChatResponse`\n\n```ts\ntype ListCustomerChatResponse = {\n  agents: Array<{\n    org_id: string\n    agent_id: string // uuid\n    place: \"website\" | \"portal\"\n    internal_name: string\n    runtime_agent_id: string // uuid\n    config: {\n      capabilities: { ... }\n      knowledgeSources: { ... }\n      escalation: { ... }\n      appearance: { ... }\n      instructions?: { ... }\n      instructionTranslations?: { ... }\n      instructionsNeedsReview?: { ... }\n    }\n    created_at: string // date-time\n    updated_at: string // date-time\n  }>\n}\n```\n\n### `CustomerChatCapabilityCatalogEntry`\n\n```ts\ntype CustomerChatCapabilityCatalogEntry = {\n  id: \"navigate_portal_pages\" | \"search_portal_records\" | \"view_billing\" | \"view_meter_readings\" | \"view_contracts\" | \"search_web\" | \"open_quick_actions\" | \"view_hems_energy\" | \"open_journey\" | \"open_link\" | \"submit_meter_reading\"\n  places: \"website\" | \"portal\"[]\n  singleInstance?: boolean\n  requiresIntegration?: boolean\n}\n```\n\n### `ListCustomerChatCapabilitiesResponse`\n\n```ts\ntype ListCustomerChatCapabilitiesResponse = {\n  capabilities: Array<{\n    id: \"navigate_portal_pages\" | \"search_portal_records\" | \"view_billing\" | \"view_meter_readings\" | \"view_contracts\" | \"search_web\" | \"open_quick_actions\" | \"view_hems_energy\" | \"open_journey\" | \"open_link\" | \"submit_meter_reading\"\n    places: \"website\" | \"portal\"[]\n    singleInstance?: boolean\n    requiresIntegration?: boolean\n  }>\n}\n```\n\n### `RenameCustomerChatAgentRequest`\n\n```ts\ntype RenameCustomerChatAgentRequest = {\n  internal_name: string\n  updated_at?: string // date-time\n}\n```\n\n### `SaveCustomerChatConfigRequest`\n\n```ts\ntype SaveCustomerChatConfigRequest = {\n  config: {\n    capabilities: Array<{\n      type: { ... }\n      instanceId?: { ... }\n      enabled: { ... }\n      meterTypes?: { ... }\n      ticketType?: { ... }\n      allowedDomains?: { ... }\n      autonomy?: { ... }\n      label?: { ... }\n      guidance?: { ... }\n      blockIds?: { ... }\n      integrationId?: { ... }\n      accessLevel?: { ... }\n      intent?: { ... }\n      journeyId?: { ... }\n      journeyName?: { ... }\n      url?: { ... }\n      searchDeviceDocs?: { ... }\n    }>\n    knowledgeSources: Array<{\n      id: { ... }\n      type: { ... }\n      title: { ... }\n      targetId: { ... }\n      detail?: { ... }\n    }>\n    escalation: {\n      websiteHandover: { ... }\n      ticketPurpose?: { ... }\n    }\n    appearance: {\n      displayName: { ... }\n      greeting: { ... }\n      starters: { ... }\n      starterKeys?: { ... }\n      launcherLabel?: { ... }\n      language: { ... }\n      formOfAddress: { ... }\n      followUps?: { ... }\n      languages?: { ... }\n      translations?: { ... }\n      needsReview?: { ... }\n    }\n    instructions?: string\n    instructionTranslations?: {\n      de?: { ... }\n      en?: { ... }\n    }\n    instructionsNeedsReview?: \"de\" | \"en\"[]\n  }\n  updated_at?: string // date-time\n}\n```\n\n### `WebsiteHandover`\n\n```ts\ntype WebsiteHandover = {\n  kind: \"phone\" | \"email\" | \"journey\" | \"ticket\" | \"unset\"\n  value: string\n  journeyId?: string\n  journeyName?: string\n}\n```\n\n### `AgentId`\n\nAgent identifier. Can be either:\n- System skill ID (prefixed): \"skill:email-categorizer\", \"skill:email-labeler\"\n- Custom agent UUID: \"0336a235-9417-4dd8-894c-fe81285bba75\"\n\n\n```ts\ntype AgentId = string\n```\n\n### `KnowledgeSourceIds`\n\nKnowledge source IDs available to this agent. An empty array clears the selection.\n\n```ts\ntype KnowledgeSourceIds = string // uuid[]\n```\n\n### `AgentDomain`\n\nBusiness domain selected in the agent builder.\n\n```ts\ntype AgentDomain = \"customer_service\" | \"sales\" | \"billing\" | \"metering_grid\" | \"other\"\n```\n\n### `CreateAgentRequest`\n\n```ts\ntype CreateAgentRequest = {\n  domain?: \"customer_service\" | \"sales\" | \"billing\" | \"metering_grid\" | \"other\"\n  availability?: \"flows\" | \"copilot\" | \"portals\" | \"website\" | \"all\"[]\n  name: string\n  description?: string\n  category?: \"message\" | \"entity\" | \"document\" | \"classification\" | \"custom\"\n  icon?: string\n  system_prompt: string\n  tools?: string[]\n  model_config?: {\n    model_id?: string\n    temperature?: number\n    max_tokens?: number\n    thinking?: boolean\n    thinking_budget?: number\n  }\n  max_iterations?: number\n  execution_pattern: \"direct\" | \"react\"\n  execution_mode?: \"automatic\" | \"approval\" | \"draft\"\n  output_schema?: object\n  input_parameters_schema?: {\n    type: \"object\"\n    parameters: Array<{\n      name: { ... }\n      label: { ... }\n      type: { ... }\n      description?: { ... }\n      default?: { ... }\n      multi?: { ... }\n      dependsOn?: { ... }\n      visibleWhen?: { ... }\n      enum?: { ... }\n      minimum?: { ... }\n      maximum?: { ... }\n      step?: { ... }\n      minLength?: { ... }\n      maxLength?: { ... }\n      schemaFilter?: { ... }\n      attributeTypeFilter?: { ... }\n      hidden?: { ... }\n    }>\n    required?: string[]\n  }\n  knowledge_source_ids?: string // uuid[]\n}\n```\n\n### `UpdateAgentRequest`\n\n```ts\ntype UpdateAgentRequest = {\n  domain?: \"customer_service\" | \"sales\" | \"billing\" | \"metering_grid\" | \"other\"\n  availability?: \"flows\" | \"copilot\" | \"portals\" | \"website\" | \"all\"[]\n  name?: string\n  description?: string\n  category?: \"message\" | \"entity\" | \"document\" | \"classification\" | \"custom\"\n  icon?: string\n  system_prompt?: string\n  tools?: string[]\n  model_config?: {\n    model_id?: string\n    temperature?: number\n    max_tokens?: number\n    thinking?: boolean\n    thinking_budget?: number\n  }\n  max_iterations?: number\n  execution_pattern?: \"direct\" | \"react\"\n  execution_mode?: \"automatic\" | \"approval\" | \"draft\"\n  output_schema?: object\n  input_parameters_schema?: {\n    type: \"object\"\n    parameters: Array<{\n      name: { ... }\n      label: { ... }\n      type: { ... }\n      description?: { ... }\n      default?: { ... }\n      multi?: { ... }\n      dependsOn?: { ... }\n      visibleWhen?: { ... }\n      enum?: { ... }\n      minimum?: { ... }\n      maximum?: { ... }\n      step?: { ... }\n      minLength?: { ... }\n      maxLength?: { ... }\n      schemaFilter?: { ... }\n      attributeTypeFilter?: { ... }\n      hidden?: { ... }\n    }>\n    required?: string[]\n  }\n  knowledge_source_ids?: string // uuid[]\n}\n```\n\n### `AgentDefinition`\n\n```ts\ntype AgentDefinition = {\n  domain?: \"customer_service\" | \"sales\" | \"billing\" | \"metering_grid\" | \"other\"\n  agent_id?: string\n  org_id?: string\n  name?: string\n  description?: string\n  category?: \"message\" | \"entity\" | \"document\" | \"classification\" | \"custom\"\n  icon?: string\n  source?: \"system\" | \"custom\"\n  availability?: \"flows\" | \"copilot\" | \"portals\" | \"website\" | \"all\"[]\n  allowed_entity_schemas?: string[]\n  system_prompt?: string\n  tools?: string[]\n  model_config?: {\n    model_id?: string\n    temperature?: number\n    max_tokens?: number\n    thinking?: boolean\n    thinking_budget?: number\n  }\n  max_iterations?: number\n  execution_pattern?: \"direct\" | \"react\"\n  execution_mode?: \"automatic\" | \"approval\" | \"draft\"\n  output_schema?: object\n  input_parameters_schema?: {\n    type: \"object\"\n    parameters: Array<{\n      name: { ... }\n      label: { ... }\n      type: { ... }\n      description?: { ... }\n      default?: { ... }\n      multi?: { ... }\n      dependsOn?: { ... }\n      visibleWhen?: { ... }\n      enum?: { ... }\n      minimum?: { ... }\n      maximum?: { ... }\n      step?: { ... }\n      minLength?: { ... }\n      maxLength?: { ... }\n      schemaFilter?: { ... }\n      attributeTypeFilter?: { ... }\n      hidden?: { ... }\n    }>\n    required?: string[]\n  }\n  knowledge_source_ids?: string // uuid[]\n  version?: number\n  created_at?: string // date-time\n  updated_at?: string // date-time\n  created_by?: string\n}\n```\n\n### `ListAgentsResponse`\n\n```ts\ntype ListAgentsResponse = {\n  agents?: Array<{\n    domain?: \"customer_service\" | \"sales\" | \"billing\" | \"metering_grid\" | \"other\"\n    agent_id?: string\n    org_id?: string\n    name?: string\n    description?: string\n    category?: \"message\" | \"entity\" | \"document\" | \"classification\" | \"custom\"\n    icon?: string\n    source?: \"system\" | \"custom\"\n    availability?: \"flows\" | \"copilot\" | \"portals\" | \"website\" | \"all\"[]\n    allowed_entity_schemas?: string[]\n    system_prompt?: string\n    tools?: string[]\n    model_config?: {\n      model_id?: { ... }\n      temperature?: { ... }\n      max_tokens?: { ... }\n      thinking?: { ... }\n      thinking_budget?: { ... }\n    }\n    max_iterations?: number\n    execution_pattern?: \"direct\" | \"react\"\n    execution_mode?: \"automatic\" | \"approval\" | \"draft\"\n    output_schema?: object\n    input_parameters_schema?: {\n      type: { ... }\n      parameters: { ... }\n      required?: { ... }\n    }\n    knowledge_source_ids?: string // uuid[]\n    version?: number\n    created_at?: string // date-time\n    updated_at?: string // date-time\n    created_by?: string\n  }>\n  next_cursor?: string\n}\n```\n\n### `ListExecutionsResponse`\n\n```ts\ntype ListExecutionsResponse = {\n  executions?: Array<{\n    execution_id?: string // uuid\n    agent_id?: string\n    agent_source?: \"system\" | \"custom\"\n    agent_name?: string\n    execution_context?: \"flows\" | \"copilot\" | \"api\" | \"sharing\"\n    org_id?: string\n    status?: \"pending\" | \"queued\" | \"running\" | \"waiting_approval\" | \"completed\" | \"failed\" | \"cancelled\"\n    input?: object\n    parameters?: object\n    result?: {\n      response?: { ... }\n      structured_output?: { ... }\n      stop_reason?: { ... }\n    }\n    error?: {\n      code?: { ... }\n      message?: { ... }\n      details?: { ... }\n    }\n    pending_action?: {\n      tool?: { ... }\n      input?: { ... }\n      description?: { ... }\n      preview?: { ... }\n      approval_note?: { ... }\n    }\n    metrics?: {\n      total_tokens?: { ... }\n      input_tokens?: { ... }\n      output_tokens?: { ... }\n      total_cost_usd?: { ... }\n      duration_ms?: { ... }\n      iteration_count?: { ... }\n    }\n    started_at?: string // date-time\n    completed_at?: string // date-time\n    iterations?: Array<{\n      index?: { ... }\n      tool?: { ... }\n      status?: { ... }\n      timestamp?: { ... }\n    }>\n  }>\n  next_cursor?: string\n}\n```\n\n### `ApproveExecutionRequest`\n\n```ts\ntype ApproveExecutionRequest = {\n  reason?: string\n  approved_action_ids?: string[]\n  rejected_action_ids?: string[]\n}\n```\n\n### `RejectExecutionRequest`\n\n```ts\ntype RejectExecutionRequest = {\n  reason: string\n}\n```\n\n### `ExecuteAgentRequest`\n\n```ts\ntype ExecuteAgentRequest = {\n  mode?: \"auto\" | \"stream\" | \"async\" | \"sync\"\n  input?: {\n    message?: string\n    entity_id?: string\n    entity_schema?: string\n    workflow_id?: string\n    workflow_execution_id?: string\n    task_id?: string\n    custom_data?: Record<string, unknown>\n    flow_context?: Array<{\n      entity_id: { ... }\n      entity_schema: { ... }\n    }>\n    attachment?: {\n      s3ref: { ... }\n      mime_type: { ... }\n      filename?: { ... }\n    }\n    attachments?: Array<{\n      s3ref: { ... }\n      mime_type: { ... }\n      filename?: { ... }\n    }>\n  }\n  parameters?: Record<string, unknown>\n  execution_mode_override?: \"automatic\" | \"approval\" | \"draft\"\n  execution_context?: \"flows\" | \"copilot\" | \"api\" | \"sharing\"\n  callback_url?: string // uri\n  timeout_ms?: number\n}\n```\n\n### `ExecuteAgentStreamRequest`\n\n```ts\ntype ExecuteAgentStreamRequest = {\n  mode?: \"auto\" | \"stream\" | \"async\" | \"sync\"\n  input?: {\n    message?: string\n    entity_id?: string\n    entity_schema?: string\n    workflow_id?: string\n    workflow_execution_id?: string\n    task_id?: string\n    custom_data?: Record<string, unknown>\n    flow_context?: Array<{\n      entity_id: { ... }\n      entity_schema: { ... }\n    }>\n    attachment?: {\n      s3ref: { ... }\n      mime_type: { ... }\n      filename?: { ... }\n    }\n    attachments?: Array<{\n      s3ref: { ... }\n      mime_type: { ... }\n      filename?: { ... }\n    }>\n  }\n  parameters?: Record<string, unknown>\n  execution_mode_override?: \"automatic\" | \"approval\" | \"draft\"\n  execution_context?: \"flows\" | \"copilot\" | \"api\" | \"sharing\"\n  callback_url?: string // uri\n  timeout_ms?: number\n  agent_override?: {\n    domain?: \"customer_service\" | \"sales\" | \"billing\" | \"metering_grid\" | \"other\"\n    availability?: \"flows\" | \"copilot\" | \"portals\" | \"website\" | \"all\"[]\n    name?: string\n    description?: string\n    category?: \"message\" | \"entity\" | \"document\" | \"classification\" | \"custom\"\n    icon?: string\n    system_prompt?: string\n    tools?: string[]\n    model_config?: {\n      model_id?: { ... }\n      temperature?: { ... }\n      max_tokens?: { ... }\n      thinking?: { ... }\n      thinking_budget?: { ... }\n    }\n    max_iterations?: number\n    execution_pattern?: \"direct\" | \"react\"\n    execution_mode?: \"automatic\" | \"approval\" | \"draft\"\n    output_schema?: object\n    input_parameters_schema?: {\n      type: { ... }\n      parameters: { ... }\n      required?: { ... }\n    }\n    knowledge_source_ids?: string // uuid[]\n  }\n}\n```\n\n### `ExecutionResponse`\n\n```ts\ntype ExecutionResponse = {\n  execution_id?: string // uuid\n  agent_id?: string\n  agent_source?: \"system\" | \"custom\"\n  agent_name?: string\n  execution_context?: \"flows\" | \"copilot\" | \"api\" | \"sharing\"\n  org_id?: string\n  status?: \"pending\" | \"queued\" | \"running\" | \"waiting_approval\" | \"completed\" | \"failed\" | \"cancelled\"\n  input?: object\n  parameters?: object\n  result?: {\n    response?: string\n    structured_output?: object\n    stop_reason?: string\n  }\n  error?: {\n    code?: \"TIMEOUT\" | \"MAX_ITERATIONS_EXCEEDED\" | \"TOOL_EXECUTION_FAILED\" | \"LLM_ERROR\" | \"INVALID_OUTPUT\" | \"REJECTED\" | \"INTERNAL_ERROR\"\n    message?: string\n    details?: object\n  }\n  pending_action?: {\n    tool?: string\n    input?: object\n    description?: string\n    preview?: {\n      action?: { ... }\n      source?: { ... }\n      target?: { ... }\n      changes?: { ... }\n      metadata?: { ... }\n      summary?: { ... }\n    }\n    approval_note?: string\n  }\n  metrics?: {\n    total_tokens?: number\n    input_tokens?: number\n    output_tokens?: number\n    total_cost_usd?: number\n    duration_ms?: number\n    iteration_count?: number\n  }\n  started_at?: string // date-time\n  completed_at?: string // date-time\n  iterations?: Array<{\n    index?: number\n    tool?: string\n    status?: \"running\" | \"completed\"\n    timestamp?: string // date-time\n  }>\n}\n```\n\n### `ExecutionIterationProjection`\n\n```ts\ntype ExecutionIterationProjection = {\n  index?: number\n  tool?: string\n  status?: \"running\" | \"completed\"\n  timestamp?: string // date-time\n}\n```\n\n### `ExecutionFeedback`\n\n```ts\ntype ExecutionFeedback = {\n  rating: \"up\" | \"down\"\n  comment?: string\n  user_id: string\n  submitted_at: string // date-time\n}\n```\n\n### `ExecutionFeedbackResponse`\n\n```ts\ntype ExecutionFeedbackResponse = {\n  feedback: {\n    rating: \"up\" | \"down\"\n    comment?: string\n    user_id: string\n    submitted_at: string // date-time\n  }\n}\n```\n\n### `PutExecutionFeedbackRequest`\n\n```ts\ntype PutExecutionFeedbackRequest = {\n  rating: \"up\" | \"down\"\n  comment?: string\n}\n```\n\n### `ExecutionTrace`\n\n```ts\ntype ExecutionTrace = {\n  execution_id?: string // uuid\n  iterations?: Array<{\n    iteration_index?: number\n    thought?: string\n    action?: {\n      tool?: { ... }\n      input?: { ... }\n    }\n    observation?: object\n    timestamp?: string // date-time\n    tokens_used?: number\n    latency_ms?: number\n  }>\n  total_iterations?: number\n}\n```\n\n### `ExecutionIteration`\n\n```ts\ntype ExecutionIteration = {\n  iteration_index?: number\n  thought?: string\n  action?: {\n    tool?: string\n    input?: object\n  }\n  observation?: object\n  timestamp?: string // date-time\n  tokens_used?: number\n  latency_ms?: number\n}\n```\n\n### `PendingAction`\n\nAction waiting for approval (when status=waiting_approval)\n\n```ts\ntype PendingAction = {\n  tool?: string\n  input?: object\n  description?: string\n  preview?: {\n    action?: {\n      type: { ... }\n      verb: { ... }\n    }\n    source?: {\n      type?: { ... }\n      id?: { ... }\n      name?: { ... }\n      schema?: { ... }\n      icon?: { ... }\n      url?: { ... }\n    }\n    target?: {\n      type?: { ... }\n      id?: { ... }\n      name?: { ... }\n      schema?: { ... }\n      icon?: { ... }\n      url?: { ... }\n    }\n    changes?: Array<{\n      field?: { ... }\n      label?: { ... }\n      from?: { ... }\n      to?: { ... }\n    }>\n    metadata?: Record<string, {\n      type: { ... }\n      value?: { ... }\n      values?: { ... }\n      id?: { ... }\n      name?: { ... }\n      schema?: { ... }\n      color?: { ... }\n    }>\n    summary?: string\n  }\n  approval_note?: string\n}\n```\n\n### `ExecutionError`\n\n```ts\ntype ExecutionError = {\n  code?: \"TIMEOUT\" | \"MAX_ITERATIONS_EXCEEDED\" | \"TOOL_EXECUTION_FAILED\" | \"LLM_ERROR\" | \"INVALID_OUTPUT\" | \"REJECTED\" | \"INTERNAL_ERROR\"\n  message?: string\n  details?: object\n}\n```\n\n### `ExecutionMetrics`\n\n```ts\ntype ExecutionMetrics = {\n  total_tokens?: number\n  input_tokens?: number\n  output_tokens?: number\n  total_cost_usd?: number\n  duration_ms?: number\n  iteration_count?: number\n}\n```\n\n### `AgentExecutionEventStatus`\n\nLifecycle status carried on an agent execution event.\n\nDeliberately narrower than `ExecutionStatus`, which is the stored status of\nthe execution row: `pending` and `running` both surface as `started`, and\n`cancelled` surfaces as `failed`. Consumers must not assume the two\nvocabularies are interchang\n\n```ts\ntype AgentExecutionEventStatus = \"started\" | \"queued\" | \"completed\" | \"failed\" | \"approval_required\"\n```\n\n### `AgentExecutionEvent`\n\nDetail payload of the `agent-execution-status-update` event, published on\nthe AI Agents event bus with source `ai-agents`.\n\n`execution_context` and `input` are present on every status, so a consumer\ncan tell whether an execution is theirs, and what it belonged to, from the\nterminal event alone — wit\n\n```ts\ntype AgentExecutionEvent = {\n  executionId: string\n  agentId: string\n  orgId: string\n  userId?: string\n  execution_status: \"started\" | \"queued\" | \"completed\" | \"failed\" | \"approval_required\"\n  execution_context?: \"flows\" | \"copilot\" | \"api\" | \"sharing\"\n  input?: Record<string, unknown>\n  output?: Record<string, unknown>\n  error?: {\n    message?: string\n    code?: string\n    stack?: string\n  }\n  duration?: number\n  iterations?: number\n  iteration?: number\n  message?: string\n  toolCalls?: Array<{\n    name?: string\n    args?: Record<string, unknown>\n  }>\n  timestamp?: string // date-time\n}\n```\n\n### `ToolPreview`\n\nStructured preview data for approval UI. Provides a generic format that any tool can populate.\n\n```ts\ntype ToolPreview = {\n  action?: {\n    type: \"move\" | \"create\" | \"update\" | \"delete\" | \"apply\" | \"send\" | \"link\" | \"unlink\" | \"batch_approval\"\n    verb: string\n  }\n  source?: {\n    type?: string\n    id?: string\n    name?: string\n    schema?: string\n    icon?: string\n    url?: string\n  }\n  target?: {\n    type?: string\n    id?: string\n    name?: string\n    schema?: string\n    icon?: string\n    url?: string\n  }\n  changes?: Array<{\n    field?: string\n    label?: string\n    from?: {\n      type: { ... }\n      value?: { ... }\n      values?: { ... }\n      id?: { ... }\n      name?: { ... }\n      schema?: { ... }\n      color?: { ... }\n    }\n    to?: {\n      type: { ... }\n      value?: { ... }\n      values?: { ... }\n      id?: { ... }\n      name?: { ... }\n      schema?: { ... }\n      color?: { ... }\n    }\n  }>\n  metadata?: Record<string, {\n    type: \"text\" | \"number\" | \"boolean\" | \"list\" | \"entity\" | \"badge\"\n    value?: unknown\n    values?: string[]\n    id?: string\n    name?: string\n    schema?: string\n    color?: \"success\" | \"warning\" | \"error\" | \"info\"\n  }>\n  summary?: string\n}\n```\n\n### `PreviewActionType`\n\nType of action being previewed\n\n```ts\ntype PreviewActionType = \"move\" | \"create\" | \"update\" | \"delete\" | \"apply\" | \"send\" | \"link\" | \"unlink\" | \"batch_approval\"\n```\n\n### `PreviewEntity`\n\nEntity reference for preview display\n\n```ts\ntype PreviewEntity = {\n  type?: string\n  id?: string\n  name?: string\n  schema?: string\n  icon?: string\n  url?: string\n}\n```\n\n### `PreviewChange`\n\nA single field change in the preview\n\n```ts\ntype PreviewChange = {\n  field?: string\n  label?: string\n  from?: {\n    type: \"text\" | \"number\" | \"boolean\" | \"list\" | \"entity\" | \"badge\"\n    value?: unknown\n    values?: string[]\n    id?: string\n    name?: string\n    schema?: string\n    color?: \"success\" | \"warning\" | \"error\" | \"info\"\n  }\n  to?: {\n    type: \"text\" | \"number\" | \"boolean\" | \"list\" | \"entity\" | \"badge\"\n    value?: unknown\n    values?: string[]\n    id?: string\n    name?: string\n    schema?: string\n    color?: \"success\" | \"warning\" | \"error\" | \"info\"\n  }\n}\n```\n\n### `PreviewValue`\n\nTyped value for preview display\n\n```ts\ntype PreviewValue = {\n  type: \"text\" | \"number\" | \"boolean\" | \"list\" | \"entity\" | \"badge\"\n  value?: unknown\n  values?: string[]\n  id?: string\n  name?: string\n  schema?: string\n  color?: \"success\" | \"warning\" | \"error\" | \"info\"\n}\n```\n\n### `ToolDefinition`\n\n```ts\ntype ToolDefinition = {\n  tool_id?: string\n  name?: string\n  description?: string\n  category?: \"entity\" | \"message\" | \"taxonomy\" | \"rag\" | \"workflow\"\n  parameters?: object\n  returns?: object\n  requires_approval?: boolean\n  enabled?: boolean\n}\n```\n\n### `SkillCategory`\n\n```ts\ntype SkillCategory = \"message\" | \"entity\" | \"document\" | \"classification\" | \"custom\"\n```\n\n### `AgentSource`\n\n- system: Pre-built by epilot (system skills)\n- custom: Created by organization\n\n\n```ts\ntype AgentSource = \"system\" | \"custom\"\n```\n\n### `SkillAvailability`\n\nWhere the skill/agent is available:\n- flows: Available in workflow automations\n- copilot: Available as a sub-agent in copilot\n- portals: Available in end-user self-service portals\n- website: Website chat, explicitly selected; currently supports anonymous execution\n- all: Available on the existing no\n\n```ts\ntype SkillAvailability = \"flows\" | \"copilot\" | \"portals\" | \"website\" | \"all\"\n```\n\n### `ExecutionContext`\n\nWhere the execution was triggered from:\n- flows: Triggered from workflow automation\n- copilot: Triggered from copilot assistant\n- api: Direct API call\n- sharing: Triggered by sharing-api auto-sharing rules\n\n\n```ts\ntype ExecutionContext = \"flows\" | \"copilot\" | \"api\" | \"sharing\"\n```\n\n### `ExecutionPattern`\n\n- direct: Single LLM call, no tools\n- react: Multi-step reasoning with tool use\n\n\n```ts\ntype ExecutionPattern = \"direct\" | \"react\"\n```\n\n### `ExecutionMode`\n\n- automatic: Execute without human intervention\n- approval: Pause for human approval before tool execution\n- draft: Execute but mark output as draft for review\n\n\n```ts\ntype ExecutionMode = \"automatic\" | \"approval\" | \"draft\"\n```\n\n### `ExecutionStatus`\n\n```ts\ntype ExecutionStatus = \"pending\" | \"queued\" | \"running\" | \"waiting_approval\" | \"completed\" | \"failed\" | \"cancelled\"\n```\n\n### `ParameterType`\n\nBase types:\n- text: Text input field\n- textarea: Multi-line text input field\n- number: Numeric input field\n- boolean: Toggle switch\n- select: Dropdown selection (requires enum array)\n\nCustom types (domain-specific):\n- entity-schema: Entity schema selector (fetches from Entity API)\n- entity-attribute\n\n```ts\ntype ParameterType = \"text\" | \"textarea\" | \"number\" | \"boolean\" | \"select\" | \"entity-schema\" | \"entity-attribute\" | \"entity-id\" | \"taxonomy\" | \"taxonomy-classification\" | \"shared-inbox\" | \"label\" | \"matching-criteria\" | \"journey-task\" | \"journey\" | \"journey-context\"\n```\n\n### `InputParameterDefinition`\n\n```ts\ntype InputParameterDefinition = {\n  name: string\n  label: string\n  type: \"text\" | \"textarea\" | \"number\" | \"boolean\" | \"select\" | \"entity-schema\" | \"entity-attribute\" | \"entity-id\" | \"taxonomy\" | \"taxonomy-classification\" | \"shared-inbox\" | \"label\" | \"matching-criteria\" | \"journey-task\" | \"journey\" | \"journey-context\"\n  description?: string\n  default?: unknown\n  multi?: boolean\n  dependsOn?: string\n  visibleWhen?: Record<string, unknown[]>\n  enum?: string[]\n  minimum?: number\n  maximum?: number\n  step?: number\n  minLength?: number\n  maxLength?: number\n  schemaFilter?: string[]\n  attributeTypeFilter?: string[]\n  hidden?: boolean\n}\n```\n\n### `InputParametersSchema`\n\n```ts\ntype InputParametersSchema = {\n  type: \"object\"\n  parameters: Array<{\n    name: string\n    label: string\n    type: \"text\" | \"textarea\" | \"number\" | \"boolean\" | \"select\" | \"entity-schema\" | \"entity-attribute\" | \"entity-id\" | \"taxonomy\" | \"taxonomy-classification\" | \"shared-inbox\" | \"label\" | \"matching-criteria\" | \"journey-task\" | \"journey\" | \"journey-context\"\n    description?: string\n    default?: unknown\n    multi?: boolean\n    dependsOn?: string\n    visibleWhen?: Record<string, unknown[]>\n    enum?: string[]\n    minimum?: number\n    maximum?: number\n    step?: number\n    minLength?: number\n    maxLength?: number\n    schemaFilter?: string[]\n    attributeTypeFilter?: string[]\n    hidden?: boolean\n  }>\n  required?: string[]\n}\n```\n\n### `ModelConfig`\n\n```ts\ntype ModelConfig = {\n  model_id?: string\n  temperature?: number\n  max_tokens?: number\n  thinking?: boolean\n  thinking_budget?: number\n}\n```\n\n### `Error`\n\n```ts\ntype Error = {\n  error?: string\n  code?: string\n  message?: string\n  details?: object\n}\n```\n\n### `AgentAuthAccessProfile`\n\nAccess profile of the agent's grant at the Access Token API (its ceiling)\n\n```ts\ntype AgentAuthAccessProfile = \"read\" | \"config:read\" | \"config:write\" | \"data:read\" | \"data:write\" | \"full\"\n```\n\n### `AgentAuthActivationRequest`\n\n```ts\ntype AgentAuthActivationRequest = {\n  access_profile: \"read\" | \"config:read\" | \"config:write\" | \"data:read\" | \"data:write\" | \"full\"\n  reason?: string\n}\n```\n\n### `AgentAuthStatus`\n\n```ts\ntype AgentAuthStatus = {\n  status: \"inactive\" | \"active\" | \"expired\"\n  agent_auth_agent_id?: string\n  activation_id?: string\n  access_profile?: \"read\" | \"config:read\" | \"config:write\" | \"data:read\" | \"data:write\" | \"full\"\n  owner_user_id?: string\n  expires_at?: string // date-time\n  expiring_soon?: boolean\n}\n```\n\n### `ChatRequest`\n\n```ts\ntype ChatRequest = {\n  agentId: string\n  message?: string\n  tool_approval?: {\n    token: string\n    approved: boolean\n    reason?: string\n  }\n  conversationId?: string // uuid\n  clientHistory?: Array<{\n    role: \"user\" | \"assistant\" | \"tool\" | \"system\"\n    content: string\n    tool_calls?: Array<{\n      id?: { ... }\n      name?: { ... }\n      input?: { ... }\n      output?: { ... }\n    }>\n  }>\n  context?: {\n    entityId?: string\n    customData?: Record<string, unknown>\n  }\n  streaming?: {\n    mode?: \"updates\" | \"messages\"\n    streamTokens?: boolean\n    includeMetadata?: boolean\n  }\n  preview_demo?: boolean\n  agent_override?: {\n    domain?: \"customer_service\" | \"sales\" | \"billing\" | \"metering_grid\" | \"other\"\n    availability?: \"flows\" | \"copilot\" | \"portals\" | \"website\" | \"all\"[]\n    name?: string\n    description?: string\n    category?: \"message\" | \"entity\" | \"document\" | \"classification\" | \"custom\"\n    icon?: string\n    system_prompt?: string\n    tools?: string[]\n    model_config?: {\n      model_id?: { ... }\n      temperature?: { ... }\n      max_tokens?: { ... }\n      thinking?: { ... }\n      thinking_budget?: { ... }\n    }\n    max_iterations?: number\n    execution_pattern?: \"direct\" | \"react\"\n    execution_mode?: \"automatic\" | \"approval\" | \"draft\"\n    output_schema?: object\n    input_parameters_schema?: {\n      type: { ... }\n      parameters: { ... }\n      required?: { ... }\n    }\n    knowledge_source_ids?: string // uuid[]\n  }\n  portal_config_override?: Record<string, unknown>\n}\n```\n\n### `ToolApprovalAnswer`\n\nThe user's answer to an `approval_required` event (Luna behind the\n`luna-tool-approvals` flag). Requires the asking turn's `conversationId` and `agentId`; `message` may\nbe omitted. On approve the server runs exactly the pending tool call\nstored in the conversation, streams its `tool_call` / `tool_re\n\n```ts\ntype ToolApprovalAnswer = {\n  token: string\n  approved: boolean\n  reason?: string\n}\n```\n\n### `ToolApprovalRequest`\n\nA tool call waiting for the user's approval; the turn has ended.\n\n```ts\ntype ToolApprovalRequest = {\n  id: string\n  tool_id: string\n  tool_call_id: string\n  title?: string\n  input: Record<string, unknown>\n  impact?: string\n  preview?: Record<string, unknown>\n  expires_at: string // date-time\n  token: string\n}\n```\n\n### `AgentPreviewOverride`\n\nAgent Builder preview: unsaved editor settings applied to the saved\ncustom agent for this request only. Nothing is persisted. Requires\npreview_demo on /v1/chat and forces draft execution mode on\n/v1/agents/{agent_id}/execute/stream. Not supported for system skills\nor Website Chat agents.\n\n\n```ts\ntype AgentPreviewOverride = {\n  domain?: \"customer_service\" | \"sales\" | \"billing\" | \"metering_grid\" | \"other\"\n  availability?: \"flows\" | \"copilot\" | \"portals\" | \"website\" | \"all\"[]\n  name?: string\n  description?: string\n  category?: \"message\" | \"entity\" | \"document\" | \"classification\" | \"custom\"\n  icon?: string\n  system_prompt?: string\n  tools?: string[]\n  model_config?: {\n    model_id?: string\n    temperature?: number\n    max_tokens?: number\n    thinking?: boolean\n    thinking_budget?: number\n  }\n  max_iterations?: number\n  execution_pattern?: \"direct\" | \"react\"\n  execution_mode?: \"automatic\" | \"approval\" | \"draft\"\n  output_schema?: object\n  input_parameters_schema?: {\n    type: \"object\"\n    parameters: Array<{\n      name: { ... }\n      label: { ... }\n      type: { ... }\n      description?: { ... }\n      default?: { ... }\n      multi?: { ... }\n      dependsOn?: { ... }\n      visibleWhen?: { ... }\n      enum?: { ... }\n      minimum?: { ... }\n      maximum?: { ... }\n      step?: { ... }\n      minLength?: { ... }\n      maxLength?: { ... }\n      schemaFilter?: { ... }\n      attributeTypeFilter?: { ... }\n      hidden?: { ... }\n    }>\n    required?: string[]\n  }\n  knowledge_source_ids?: string // uuid[]\n}\n```\n\n### `ChatMessage`\n\n```ts\ntype ChatMessage = {\n  role: \"user\" | \"assistant\" | \"tool\" | \"system\"\n  content: string\n  tool_calls?: Array<{\n    id?: string\n    name?: string\n    input?: object\n    output?: string\n  }>\n}\n```\n\n### `StreamingOptions`\n\n```ts\ntype StreamingOptions = {\n  mode?: \"updates\" | \"messages\"\n  streamTokens?: boolean\n  includeMetadata?: boolean\n}\n```\n\n### `StreamEvent`\n\nServer-Sent Event for streaming responses\n\n```ts\ntype StreamEvent = {\n  type?: \"token\" | \"agent_step\" | \"tool_call\" | \"tool_result\" | \"complete\" | \"error\" | \"metadata\" | \"needs_approval\" | \"approval_required\"\n  content?: string\n  approval?: {\n    id: string\n    tool_id: string\n    tool_call_id: string\n    title?: string\n    input: Record<string, unknown>\n    impact?: string\n    preview?: Record<string, unknown>\n    expires_at: string // date-time\n    token: string\n  }\n  index?: number\n  tool?: string\n  input?: object\n  output?: string\n  callId?: string\n  result?: {\n    response?: string\n    structured_output?: object\n    status?: \"completed\" | \"failed\" | \"max_iterations\" | \"rejected\"\n    metrics?: {\n      total_tokens?: { ... }\n      input_tokens?: { ... }\n      output_tokens?: { ... }\n      total_cost_usd?: { ... }\n      duration_ms?: { ... }\n      iteration_count?: { ... }\n    }\n  }\n  error?: {\n    code?: string\n    message?: string\n  }\n  conversationId?: string // uuid\n}\n```\n\n### `ExecutionResult`\n\n```ts\ntype ExecutionResult = {\n  response?: string\n  structured_output?: object\n  status?: \"completed\" | \"failed\" | \"max_iterations\" | \"rejected\"\n  metrics?: {\n    total_tokens?: number\n    input_tokens?: number\n    output_tokens?: number\n    total_cost_usd?: number\n    duration_ms?: number\n    iteration_count?: number\n  }\n}\n```\n\n### `ConversationItem`\n\n```ts\ntype ConversationItem = {\n  conversation_id?: string // uuid\n  user_id?: string\n  agent_id?: string\n  title?: string\n  message_count?: number\n  last_message?: string\n  last_message_at?: string // date-time\n  context?: {\n    entityId?: string\n    customData?: object\n  }\n  created_at?: string // date-time\n  updated_at?: string // date-time\n}\n```\n\n### `MessageItem`\n\n```ts\ntype MessageItem = {\n  conversation_id?: string // uuid\n  role?: \"user\" | \"assistant\" | \"tool\" | \"system\"\n  content?: string\n  timestamp?: string // date-time\n  tool_calls?: Array<{\n    id?: string\n    name?: string\n    input?: object\n    output?: string\n  }>\n  token_count?: number\n  trace_id?: string // uuid\n  feedback?: {\n    rating: \"up\" | \"down\"\n    comment?: string\n    user_id: string\n    submitted_at: string // date-time\n  }\n}\n```\n\n### `MessageFeedback`\n\n```ts\ntype MessageFeedback = {\n  rating: \"up\" | \"down\"\n  comment?: string\n  user_id: string\n  submitted_at: string // date-time\n}\n```\n\n### `SubmitFeedbackRequest`\n\n```ts\ntype SubmitFeedbackRequest = {\n  trace_id: string // uuid\n  rating: \"up\" | \"down\"\n  comment?: string\n}\n```\n\n### `CustomerChatConversation`\n\n```ts\ntype CustomerChatConversation = {\n  conversation_id: string\n  user_id: string\n  contact_id?: string\n  title?: string\n  message_count: number\n  last_message?: string\n  last_message_at: string // date-time\n  created_at: string // date-time\n  ticket_ids: string[]\n}\n```\n\n### `CustomerChatConversationMessage`\n\n```ts\ntype CustomerChatConversationMessage = {\n  role: \"user\" | \"assistant\"\n  content: string\n  timestamp: string // date-time\n}\n```\n\n### `InternalPortalChat`\n\nA v2 portal chat in v1's conversation shape\n\n```ts\ntype InternalPortalChat = {\n  conversation_id: string\n  user_id: string\n  contact_id?: string\n  title?: string\n  message_count: number\n  last_message?: string\n  last_message_at: string // date-time\n  created_at: string // date-time\n  ticket_ids: string[]\n}\n```\n\n### `InternalPortalChatPlace`\n\nWhere a v2 portal chat is in the history's order\n\n```ts\ntype InternalPortalChatPlace = {\n  conversation_id: string\n  updated_at: string // date-time\n}\n```\n\n### `InternalPortalChats`\n\n```ts\ntype InternalPortalChats = {\n  conversations: Array<{\n    conversation_id: string\n    updated_at: string // date-time\n  }>\n  has_more: boolean\n  read_to?: {\n    conversation_id: string\n    updated_at: string // date-time\n  }\n}\n```\n\n### `InternalPortalChatRows`\n\n```ts\ntype InternalPortalChatRows = {\n  conversations: Array<{\n    conversation_id: string\n    user_id: string\n    contact_id?: string\n    title?: string\n    message_count: number\n    last_message?: string\n    last_message_at: string // date-time\n    created_at: string // date-time\n    ticket_ids: string[]\n  }>\n}\n```\n\n### `InternalPortalChatTranscript`\n\n```ts\ntype InternalPortalChatTranscript = {\n  conversation: {\n    conversation_id: string\n    user_id: string\n    contact_id?: string\n    title?: string\n    message_count: number\n    last_message?: string\n    last_message_at: string // date-time\n    created_at: string // date-time\n    ticket_ids: string[]\n  }\n  messages: Array<{\n    role: \"user\" | \"assistant\"\n    content: string\n    timestamp: string // date-time\n    blocked?: boolean\n  }>\n}\n```\n\n### `ListCustomerChatConversationsResponse`\n\n```ts\ntype ListCustomerChatConversationsResponse = {\n  conversations: Array<{\n    conversation_id: string\n    user_id: string\n    contact_id?: string\n    title?: string\n    message_count: number\n    last_message?: string\n    last_message_at: string // date-time\n    created_at: string // date-time\n    ticket_ids: string[]\n  }>\n  next_cursor?: string\n}\n```\n\n### `CustomerChatConversationTranscript`\n\n```ts\ntype CustomerChatConversationTranscript = {\n  conversation: {\n    conversation_id: string\n    user_id: string\n    contact_id?: string\n    title?: string\n    message_count: number\n    last_message?: string\n    last_message_at: string // date-time\n    created_at: string // date-time\n    ticket_ids: string[]\n  }\n  messages: Array<{\n    role: \"user\" | \"assistant\"\n    content: string\n    timestamp: string // date-time\n  }>\n}\n```\n\n### `ListConversationsResponse`\n\n```ts\ntype ListConversationsResponse = {\n  conversations?: Array<{\n    conversation_id?: string // uuid\n    user_id?: string\n    agent_id?: string\n    title?: string\n    message_count?: number\n    last_message?: string\n    last_message_at?: string // date-time\n    context?: {\n      entityId?: { ... }\n      customData?: { ... }\n    }\n    created_at?: string // date-time\n    updated_at?: string // date-time\n  }>\n  next_cursor?: string\n}\n```\n\n### `ConversationWithMessages`\n\n```ts\ntype ConversationWithMessages = {\n  conversation?: {\n    conversation_id?: string // uuid\n    user_id?: string\n    agent_id?: string\n    title?: string\n    message_count?: number\n    last_message?: string\n    last_message_at?: string // date-time\n    context?: {\n      entityId?: { ... }\n      customData?: { ... }\n    }\n    created_at?: string // date-time\n    updated_at?: string // date-time\n  }\n  messages?: Array<{\n    conversation_id?: string // uuid\n    role?: \"user\" | \"assistant\" | \"tool\" | \"system\"\n    content?: string\n    timestamp?: string // date-time\n    tool_calls?: Array<{\n      id?: { ... }\n      name?: { ... }\n      input?: { ... }\n      output?: { ... }\n    }>\n    token_count?: number\n    trace_id?: string // uuid\n    feedback?: {\n      rating: { ... }\n      comment?: { ... }\n      user_id: { ... }\n      submitted_at: { ... }\n    }\n  }>\n}\n```\n\n### `SessionsError`\n\nAn error of the Sessions API\n\n```ts\ntype SessionsError = {\n  error: {\n    message: string\n    issues?: Array<{\n      code: { ... }\n      path: { ... }\n      message: { ... }\n    }>\n    requestId?: string\n  }\n}\n```\n\n### `ValidationIssue`\n\n```ts\ntype ValidationIssue = {\n  code: string\n  path: string | number[]\n  message: string\n}\n```\n\n### `RefusalDetails`\n\n```ts\ntype RefusalDetails = {\n  code: \"not_enabled\" | \"quota_exceeded\" | \"refused\" | \"portal_chat_off\" | \"portal_chat_unavailable\" | \"message_too_long\" | \"screening_unavailable\" | \"rate_limited\" | \"usage_limit\"\n  message: string\n  limit?: \"concurrent_sessions\" | \"active_vms\" | \"daily_budget\"\n  retryAfterSeconds?: number\n}\n```\n\n### `Refusal`\n\nA refusal the client tells the user about; `error` repeats it, like every other error\n\n```ts\ntype Refusal = {\n  code: \"not_enabled\" | \"quota_exceeded\" | \"refused\" | \"portal_chat_off\" | \"portal_chat_unavailable\" | \"message_too_long\" | \"screening_unavailable\" | \"rate_limited\" | \"usage_limit\"\n  message: string\n  limit?: \"concurrent_sessions\" | \"active_vms\" | \"daily_budget\"\n  retryAfterSeconds?: number\n  error: {\n    code: \"not_enabled\" | \"quota_exceeded\" | \"refused\" | \"portal_chat_off\" | \"portal_chat_unavailable\" | \"message_too_long\" | \"screening_unavailable\" | \"rate_limited\" | \"usage_limit\"\n    message: string\n    limit?: \"concurrent_sessions\" | \"active_vms\" | \"daily_budget\"\n    retryAfterSeconds?: number\n  }\n}\n```\n\n### `RequestId`\n\nThe client's id for the request: sent again on a retry, it is taken once\n\n```ts\ntype RequestId = string // uuid\n```\n\n### `SessionStatus`\n\n`starting`: its VM starts or the agent catches up; `failed`: its last turn couldn't run\n\n```ts\ntype SessionStatus = \"idle\" | \"starting\" | \"running\" | \"failed\"\n```\n\n### `SessionLiveInfo`\n\nHow to subscribe to the session's live messages on AppSync Events\n\n```ts\ntype SessionLiveInfo = {\n  transport: \"appsync\"\n  httpHost: string\n  realtimeUrl: string\n  channel: string\n}\n```\n\n### `SessionView`\n\n```ts\ntype SessionView = {\n  id: string // uuid\n  agentId: string\n  mode: \"read\" | \"write\"\n  title: string\n  origin?: string\n  createdAt: string // date-time\n  updatedAt: string // date-time\n  status: \"idle\" | \"starting\" | \"running\" | \"failed\"\n  live?: {\n    transport: \"appsync\"\n    httpHost: string\n    realtimeUrl: string\n    channel: string\n  }\n}\n```\n\n### `SessionOrigin`\n\nWhere in the product a session is started, e.g. `configuration-hub`\n\n```ts\ntype SessionOrigin = string\n```\n\n### `CreateInternalSessionRequest`\n\n```ts\ntype CreateInternalSessionRequest = {\n  agentId?: string\n  origin: string\n  owner: {\n    user_id: string\n  }\n  unattended: true\n  client_token?: string\n  input: {\n    text: string\n    context: {\n      intent: { ... }\n    }\n  }\n}\n```\n\n### `CreateInternalExecutionRequest`\n\n```ts\ntype CreateInternalExecutionRequest = {\n  execution_id: string\n  agent_id: string\n  input: {\n    text: string\n    context?: Record<string, unknown>\n  }\n  mode?: \"automatic\" | \"approval\" | \"draft\"\n  skill?: {\n    instructions: string\n    tools: string[]\n    output_schema?: Record<string, unknown>\n  }\n  parameters?: Record<string, unknown>\n  flows?: {\n    workflow_id?: string\n    workflow_name?: string\n    workflow_execution_id?: string\n    task_id?: string\n  }\n}\n```\n\n### `ExecutionDecisionRequest`\n\n```ts\ntype ExecutionDecisionRequest = {\n  approval_id: string\n  approved: boolean\n  reason?: string\n  decided_by: string\n}\n```\n\n### `ExecutionDecision`\n\n```ts\ntype ExecutionDecision = {\n  approval: {\n    id: string\n    status: string\n  }\n}\n```\n\n### `CreatedInternalExecution`\n\n```ts\ntype CreatedInternalExecution = {\n  session_id: string // uuid\n}\n```\n\n### `CreatedInternalSession`\n\n```ts\ntype CreatedInternalSession = {\n  id: string // uuid\n  unattended_access: boolean\n}\n```\n\n### `InternalSessionStatus`\n\n```ts\ntype InternalSessionStatus = {\n  id: string // uuid\n  state: \"working\" | \"needs_owner\" | \"idle\" | \"failed\"\n  needs: \"first_message\" | \"approval\" | \"answer\" | null\n  attended: boolean\n  last_activity_at: string // date-time\n  turns: number\n}\n```\n\n### `SessionResponse`\n\n```ts\ntype SessionResponse = {\n  session: {\n    id: string // uuid\n    agentId: string\n    mode: \"read\" | \"write\"\n    title: string\n    origin?: string\n    createdAt: string // date-time\n    updatedAt: string // date-time\n    status: \"idle\" | \"starting\" | \"running\" | \"failed\"\n    live?: {\n      transport: { ... }\n      httpHost: { ... }\n      realtimeUrl: { ... }\n      channel: { ... }\n    }\n  }\n}\n```\n\n### `SessionList`\n\n```ts\ntype SessionList = {\n  sessions: Array<{\n    id: string // uuid\n    agentId: string\n    mode: \"read\" | \"write\"\n    title: string\n    origin?: string\n    createdAt: string // date-time\n    updatedAt: string // date-time\n    status: \"idle\" | \"starting\" | \"running\" | \"failed\"\n    live?: {\n      transport: { ... }\n      httpHost: { ... }\n      realtimeUrl: { ... }\n      channel: { ... }\n    }\n  }>\n}\n```\n\n### `CreatedSession`\n\n```ts\ntype CreatedSession = {\n  session: {\n    id: string // uuid\n    agentId: string\n    mode: \"read\" | \"write\"\n    title: string\n    origin?: string\n    createdAt: string // date-time\n    updatedAt: string // date-time\n    status: \"idle\" | \"starting\" | \"running\" | \"failed\"\n    live?: {\n      transport: { ... }\n      httpHost: { ... }\n      realtimeUrl: { ... }\n      channel: { ... }\n    }\n  }\n  events: Array<{\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"input\"\n    input: {\n      kind: { ... }\n      text: { ... }\n      files?: { ... }\n    } | {\n      kind: { ... }\n    }\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId: string\n    type: \"input.taken\"\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId: string\n    type: \"input.cancelled\"\n    reason: \"stopped\" | \"deleted\"\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId: string\n    type: \"input.failed\"\n    errorCode: \"model_unavailable\" | \"tool_timeout\" | \"turn_timeout\" | \"wake_failed\" | \"boot_failed\" | \"workspace_lost\" | \"budget_exceeded\" | \"internal\"\n    error: string\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"turn.started\"\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"model.usage\"\n    usage: {\n      input: { ... }\n      output: { ... }\n      cacheRead: { ... }\n      cacheWrite: { ... }\n    }\n    context?: {\n      window: { ... }\n      parts: { ... }\n    }\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"context.compacted\"\n    tokensBefore: number\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"turn.ended\"\n    reason: \"done\" | \"stopped\" | \"failed\"\n    error?: string\n    errorCode?: \"model_unavailable\" | \"tool_timeout\" | \"turn_timeout\" | \"wake_failed\" | \"boot_failed\" | \"workspace_lost\" | \"budget_exceeded\" | \"internal\"\n    cutOff?: boolean\n  } | {\n    seq: number\n  // ...\n}\n```\n\n### `SessionEventsPage`\n\n```ts\ntype SessionEventsPage = {\n  events: Array<{\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"input\"\n    input: {\n      kind: { ... }\n      text: { ... }\n      files?: { ... }\n    } | {\n      kind: { ... }\n    }\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId: string\n    type: \"input.taken\"\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId: string\n    type: \"input.cancelled\"\n    reason: \"stopped\" | \"deleted\"\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId: string\n    type: \"input.failed\"\n    errorCode: \"model_unavailable\" | \"tool_timeout\" | \"turn_timeout\" | \"wake_failed\" | \"boot_failed\" | \"workspace_lost\" | \"budget_exceeded\" | \"internal\"\n    error: string\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"turn.started\"\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"model.usage\"\n    usage: {\n      input: { ... }\n      output: { ... }\n      cacheRead: { ... }\n      cacheWrite: { ... }\n    }\n    context?: {\n      window: { ... }\n      parts: { ... }\n    }\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"context.compacted\"\n    tokensBefore: number\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"turn.ended\"\n    reason: \"done\" | \"stopped\" | \"failed\"\n    error?: string\n    errorCode?: \"model_unavailable\" | \"tool_timeout\" | \"turn_timeout\" | \"wake_failed\" | \"boot_failed\" | \"workspace_lost\" | \"budget_exceeded\" | \"internal\"\n    cutOff?: boolean\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"message\"\n    text: string\n    reasoning?: string\n    reasoningMs?: number\n  } | {\n    seq: number\n    eventId: string\n    occurredAt: string // date-time\n    blocked?: boolean\n    inputEventId?: string\n    type: \"step.started\"\n    stepId: string\n  // ...\n}\n```\n\n### `MessageInput`\n\nThe user's message, its text (trimmed), its files, or both\n\n```ts\ntype MessageInput = {\n  text?: string\n  context?: Record<string, unknown>\n  files?: string // uuid[]\n}\n```\n\n### `CreatePortalSessionRequest`\n\nA portal chat; the portal's settings choose its agent.\n\n```ts\ntype CreatePortalSessionRequest = {\n  requestId?: string // uuid\n  input?: {\n    text: string\n    context?: Record<string, unknown>\n  }\n}\n```\n\n### `PortalChatConfig`\n\n```ts\ntype PortalChatConfig = {\n  agent: {\n    name?: string\n    greeting?: string\n    conversation_starters?: string[]\n    language?: string\n    formality?: string\n  }\n}\n```\n\n### `CreateSessionRequest`\n\n```ts\ntype CreateSessionRequest = {\n  agentId: string\n  requestId?: string // uuid\n  origin?: string\n  input?: {\n    text?: string\n    context?: Record<string, unknown>\n    files?: string // uuid[]\n  }\n  prepare?: boolean\n}\n```\n\n### `RenameSessionRequest`\n\n```ts\ntype RenameSessionRequest = {\n  title: string\n}\n```\n\n### `ClientInput`\n\nThe user's input to a session\n\n```ts\ntype ClientInput = {\n  text?: string\n  context?: Record<string, unknown>\n  files?: string // uuid[]\n  type: \"user.message\"\n  requestId?: string // uuid\n} | {\n  type: \"user.approval\"\n  approvalId: string // uuid\n  approved: boolean\n  reason?: string\n} | {\n  type: \"user.answer\"\n  questionId: string // uuid\n  answers: Array<{\n    selected: string[]\n    other?: string\n  }>\n} | {\n  type: \"user.interrupt\"\n  requestId?: string // uuid\n}\n```\n\n### `UserMessageInput`\n\nA message. It closes open questions and expires pending approvals.\n\n```ts\ntype UserMessageInput = {\n  text?: string\n  context?: Record<string, unknown>\n  files?: string // uuid[]\n  type: \"user.message\"\n  requestId?: string // uuid\n}\n```\n\n### `UserApprovalInput`\n\nApproves or rejects what the agent asked to do (`approval.required`)\n\n```ts\ntype UserApprovalInput = {\n  type: \"user.approval\"\n  approvalId: string // uuid\n  approved: boolean\n  reason?: string\n}\n```\n\n### `UserAnswerInput`\n\nThe user's answers to the agent's questions (`question.asked`), one per question\n\n```ts\ntype UserAnswerInput = {\n  type: \"user.answer\"\n  questionId: string // uuid\n  answers: Array<{\n    selected: string[]\n    other?: string\n  }>\n}\n```\n\n### `UserInterruptInput`\n\nStops the agent's turn\n\n```ts\ntype UserInterruptInput = {\n  type: \"user.interrupt\"\n  requestId?: string // uuid\n}\n```\n\n### `InputEventId`\n\nThe input as stored (a message, also a blocked one or a retry's first attempt; an approval decision; answers): the turn that answers it names it on `turn.started` and `turn.ended` (`inputEventId`), so a client follows this input's turn and no other's.\n\n```ts\ntype InputEventId = string // uuid\n```\n\n### `SessionInputAccepted`\n\nWhat was accepted: a message or an interrupt, an approval decision, or answers\n\n```ts\ntype SessionInputAccepted = {\n  accepted: true\n  blocked?: boolean\n  inputEventId?: string // uuid\n} | {\n  approval: {\n    id: string // uuid\n    status: \"pending\" | \"approved\" | \"rejected\" | \"executed\" | \"expired\"\n  }\n  inputEventId?: string // uuid\n} | {\n  inputEventId?: string // uuid\n  question: {\n    id: string // uuid\n    status: \"pending\" | \"answered\" | \"dismissed\"\n  }\n}\n```\n\n### `UploadRequest`\n\n```ts\ntype UploadRequest = {\n  name: string\n  mediaType: \"image/png\" | \"image/jpeg\" | \"image/webp\" | \"image/gif\" | \"application/pdf\" | \"text/csv\" | \"text/plain\" | \"text/markdown\" | \"application/json\" | \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\" | \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\"\n  size: number\n}\n```\n\n### `SessionUpload`\n\n```ts\ntype SessionUpload = {\n  file: {\n    fileId: string // uuid\n    name: string\n    mediaType: string\n    size: number\n  }\n  upload: {\n    method: \"PUT\"\n    url: string\n    headers: Record<string, string>\n  }\n}\n```\n\n### `FileRef`\n\nA file in a session\n\n```ts\ntype FileRef = {\n  fileId: string // uuid\n  name: string\n  mediaType: string\n  size: number\n}\n```\n\n### `SessionFileUrl`\n\n```ts\ntype SessionFileUrl = {\n  url: string\n  expiresAt: string // date-time\n}\n```\n\n### `RunScriptRequest`\n\n```ts\ntype RunScriptRequest = {\n  language: \"javascript\" | \"python\"\n  script: string\n  description: string\n  waitMs?: number\n}\n```\n\n### `ScriptRunView`\n\n```ts\ntype ScriptRunView = {\n  runId: string\n  status: \"running\" | \"done\" | \"failed\"\n  output?: string\n  changes?: number\n}\n```\n\n### `ApplyScriptRunRequest`\n\n```ts\ntype ApplyScriptRunRequest = {\n  approvalSummary: string\n}\n```\n\n### `ScriptApplyResult`\n\n```ts\ntype ScriptApplyResult = {\n  done: boolean\n  applied: number\n  total: number\n  result?: {\n    content: Array<{\n      type: { ... }\n      text: { ... }\n    } | {\n      type: { ... }\n      mimeType: { ... }\n      data?: { ... }\n      key?: { ... }\n    } | {\n      type: { ... }\n      thinking: { ... }\n      redacted?: { ... }\n    } | {\n      type: { ... }\n      id: { ... }\n      name: { ... }\n      arguments: { ... }\n    }>\n    isError: boolean\n  }\n}\n```\n\n### `ContentPart`\n\n```ts\ntype ContentPart = {\n  type: \"text\"\n  text: string\n} | {\n  type: \"image\"\n  mimeType: string\n  data?: string\n  key?: string\n} | {\n  type: \"thinking\"\n  thinking: string\n  redacted?: boolean\n} | {\n  type: \"tool_call\"\n  id: string\n  name: string\n  arguments: Record<string, unknown>\n}\n```\n\n### `TextContentPart`\n\n```ts\ntype TextContentPart = {\n  type: \"text\"\n  text: string\n}\n```\n\n### `ImageContentPart`\n\n```ts\ntype ImageContentPart = {\n  type: \"image\"\n  mimeType: string\n  data?: string\n  key?: string\n}\n```\n\n### `ThinkingContentPart`\n\n```ts\ntype ThinkingContentPart = {\n  type: \"thinking\"\n  thinking: string\n  redacted?: boolean\n}\n```\n\n### `ToolCallContentPart`\n\n```ts\ntype ToolCallContentPart = {\n  type: \"tool_call\"\n  id: string\n  name: string\n  arguments: Record<string, unknown>\n}\n```\n\n### `SessionErrorCode`\n\nWhy a turn or an input failed, for the user's copy\n\n```ts\ntype SessionErrorCode = \"model_unavailable\" | \"tool_timeout\" | \"turn_timeout\" | \"wake_failed\" | \"boot_failed\" | \"workspace_lost\" | \"budget_exceeded\" | \"internal\"\n```\n\n### `ContextBreakdown`\n\nWhat filled the model's context on one call, in tokens\n\n```ts\ntype ContextBreakdown = {\n  window: number\n  parts: {\n    instructions?: number\n    user?: number\n    replies?: number\n    thinking?: number\n    toolCalls?: number\n    toolResults?: number\n    files?: number\n    summary?: number\n  }\n}\n```\n\n### `BatchChange`\n\nA change the agent asks to make, exactly as it will run\n\n```ts\ntype BatchChange = {\n  operationId: string\n  service?: string\n  method: string\n  path: string\n  effect: \"read\" | \"write\" | \"config\" | \"destructive\"\n  pathParameters?: Record<string, unknown>\n  queryParameters?: Record<string, unknown>\n  body?: unknown\n  title?: string\n}\n```\n\n### `ChangeOutcome`\n\nWhat happened to one change of an approved batch\n\n```ts\ntype ChangeOutcome = {\n  change: number\n  status: \"ok\" | \"failed\" | \"skipped\"\n  operationId: string\n  error?: string\n  mayHaveRun?: boolean\n  record?: {\n    _id?: string\n    _title?: string\n    _schema?: string\n  }\n}\n```\n\n### `Question`\n\n```ts\ntype Question = {\n  header: string\n  question: string\n  multiSelect?: boolean\n  options: Array<{\n    label: string\n    description?: string\n  }>\n}\n```\n\n### `Answer`\n\nOne answer per question, in order: the labels picked, and/or the user's own words\n\n```ts\ntype Answer = {\n  selected: string[]\n  other?: string\n}\n```\n\n### `ClientEvent`\n\nWhat a client sees of a session's history. Every event carries the `seq` of the stored event it comes\nfrom, so history, live messages and reconnects can overlap and a client applies each event once.\n\n\n```ts\ntype ClientEvent = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"input\"\n  input: {\n    kind: \"message\"\n    text: string\n    files?: Array<{\n      fileId: { ... }\n      name: { ... }\n      mediaType: { ... }\n      size: { ... }\n    }>\n  } | {\n    kind: \"interrupt\"\n  }\n} | {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId: string\n  type: \"input.taken\"\n} | {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId: string\n  type: \"input.cancelled\"\n  reason: \"stopped\" | \"deleted\"\n} | {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId: string\n  type: \"input.failed\"\n  errorCode: \"model_unavailable\" | \"tool_timeout\" | \"turn_timeout\" | \"wake_failed\" | \"boot_failed\" | \"workspace_lost\" | \"budget_exceeded\" | \"internal\"\n  error: string\n} | {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"turn.started\"\n} | {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"model.usage\"\n  usage: {\n    input: number\n    output: number\n    cacheRead: number\n    cacheWrite: number\n  }\n  context?: {\n    window: number\n    parts: {\n      instructions?: { ... }\n      user?: { ... }\n      replies?: { ... }\n      thinking?: { ... }\n      toolCalls?: { ... }\n      toolResults?: { ... }\n      files?: { ... }\n      summary?: { ... }\n    }\n  }\n} | {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"context.compacted\"\n  tokensBefore: number\n} | {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"turn.ended\"\n  reason: \"done\" | \"stopped\" | \"failed\"\n  error?: string\n  errorCode?: \"model_unavailable\" | \"tool_timeout\" | \"turn_timeout\" | \"wake_failed\" | \"boot_failed\" | \"workspace_lost\" | \"budget_exceeded\" | \"internal\"\n  cutOff?: boolean\n} | {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  // ...\n}\n```\n\n### `ClientEventBase`\n\n```ts\ntype ClientEventBase = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n}\n```\n\n### `ClientEventInput`\n\nThe user's message, or their interrupt\n\n```ts\ntype ClientEventInput = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"input\"\n  input: {\n    kind: \"message\"\n    text: string\n    files?: Array<{\n      fileId: { ... }\n      name: { ... }\n      mediaType: { ... }\n      size: { ... }\n    }>\n  } | {\n    kind: \"interrupt\"\n  }\n}\n```\n\n### `ClientEventInputTaken`\n\nThe agent took the user's message `inputEventId`, where it reads it\n\n```ts\ntype ClientEventInputTaken = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId: string\n  type: \"input.taken\"\n}\n```\n\n### `ClientEventInputCancelled`\n\nThe message will not be answered: the user stopped the turn, or the session was deleted\n\n```ts\ntype ClientEventInputCancelled = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId: string\n  type: \"input.cancelled\"\n  reason: \"stopped\" | \"deleted\"\n}\n```\n\n### `ClientEventInputFailed`\n\nThe message failed again and again and was skipped, so the session goes on\n\n```ts\ntype ClientEventInputFailed = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId: string\n  type: \"input.failed\"\n  errorCode: \"model_unavailable\" | \"tool_timeout\" | \"turn_timeout\" | \"wake_failed\" | \"boot_failed\" | \"workspace_lost\" | \"budget_exceeded\" | \"internal\"\n  error: string\n}\n```\n\n### `ClientEventTurnStarted`\n\n```ts\ntype ClientEventTurnStarted = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"turn.started\"\n}\n```\n\n### `ClientEventModelUsage`\n\nOne model call: what it read and wrote, and what filled its context\n\n```ts\ntype ClientEventModelUsage = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"model.usage\"\n  usage: {\n    input: number\n    output: number\n    cacheRead: number\n    cacheWrite: number\n  }\n  context?: {\n    window: number\n    parts: {\n      instructions?: { ... }\n      user?: { ... }\n      replies?: { ... }\n      thinking?: { ... }\n      toolCalls?: { ... }\n      toolResults?: { ... }\n      files?: { ... }\n      summary?: { ... }\n    }\n  }\n}\n```\n\n### `ClientEventContextCompacted`\n\nOlder messages were summarized to make room; the context held `tokensBefore` until then\n\n```ts\ntype ClientEventContextCompacted = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"context.compacted\"\n  tokensBefore: number\n}\n```\n\n### `ClientEventTurnEnded`\n\n```ts\ntype ClientEventTurnEnded = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"turn.ended\"\n  reason: \"done\" | \"stopped\" | \"failed\"\n  error?: string\n  errorCode?: \"model_unavailable\" | \"tool_timeout\" | \"turn_timeout\" | \"wake_failed\" | \"boot_failed\" | \"workspace_lost\" | \"budget_exceeded\" | \"internal\"\n  cutOff?: boolean\n}\n```\n\n### `ClientEventMessage`\n\nThe agent's answer\n\n```ts\ntype ClientEventMessage = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"message\"\n  text: string\n  reasoning?: string\n  reasoningMs?: number\n}\n```\n\n### `ClientEventStepStarted`\n\nThe agent calls a tool\n\n```ts\ntype ClientEventStepStarted = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"step.started\"\n  stepId: string\n  tool: string\n  input: Record<string, unknown>\n}\n```\n\n### `ClientEventStepFinished`\n\n```ts\ntype ClientEventStepFinished = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"step.finished\"\n  stepId: string\n  tool: string\n  ok: boolean\n  output: string\n  marker?: \"interrupted\" | \"may_have_run\"\n}\n```\n\n### `ClientEventSkillLoaded`\n\n```ts\ntype ClientEventSkillLoaded = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"skill.loaded\"\n  skill: string\n  version?: string\n  stepId?: string\n}\n```\n\n### `ClientEventApprovalRequired`\n\nThe agent asks to make changes: approve or reject with `user.approval`\n\n```ts\ntype ClientEventApprovalRequired = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"approval.required\"\n  approvalId: string\n  stepId: string\n  tool: string\n  summary: string\n  changes?: Array<{\n    operationId: string\n    service?: string\n    method: string\n    path: string\n    effect: \"read\" | \"write\" | \"config\" | \"destructive\"\n    pathParameters?: Record<string, unknown>\n    queryParameters?: Record<string, unknown>\n    body?: unknown\n    title?: string\n  }>\n  executionId?: string\n  call?: {\n    operationId: string\n    service?: string\n    method: string\n    path: string\n    effect: \"read\" | \"write\" | \"config\" | \"destructive\"\n    pathParameters?: Record<string, unknown>\n    queryParameters?: Record<string, unknown>\n    body?: unknown\n    title?: string\n  }\n  card?: Record<string, unknown>\n}\n```\n\n### `ClientEventApprovalResolved`\n\n```ts\ntype ClientEventApprovalResolved = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"approval.resolved\"\n  approvalId: string\n  approved: boolean\n  reason?: string\n}\n```\n\n### `ClientEventApprovalExecuted`\n\nAn approved batch ran: every change ran, or it stopped at the first failure\n\n```ts\ntype ClientEventApprovalExecuted = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"approval.executed\"\n  approvalId: string\n  stepId: string\n  applied: number\n  total: number\n  complete: boolean\n  stopped?: boolean\n  changes: Array<{\n    change: number\n    status: \"ok\" | \"failed\" | \"skipped\"\n    operationId: string\n    error?: string\n    mayHaveRun?: boolean\n    record?: {\n      _id?: { ... }\n      _title?: { ... }\n      _schema?: { ... }\n    }\n  }>\n}\n```\n\n### `ClientEventApprovalResult`\n\nAn approved single call ran: its result, as `step.finished` shows a step's (a client reads its markers there, e.g. a portal's ticket or open directive)\n\n```ts\ntype ClientEventApprovalResult = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"approval.result\"\n  approvalId: string\n  stepId: string\n  tool: string\n  ok: boolean\n  output: string\n}\n```\n\n### `ClientEventQuestionAsked`\n\nThe agent asks the user: answer with `user.answer`\n\n```ts\ntype ClientEventQuestionAsked = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"question.asked\"\n  questionId: string\n  stepId: string\n  questions: Array<{\n    header: string\n    question: string\n    multiSelect?: boolean\n    options: Array<{\n      label: { ... }\n      description?: { ... }\n    }>\n  }>\n}\n```\n\n### `ClientEventFilesCreated`\n\nFiles the agent wrote for the user in this turn\n\n```ts\ntype ClientEventFilesCreated = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"files.created\"\n  files: Array<{\n    fileId: string // uuid\n    name: string\n    mediaType: string\n    size: number\n  }>\n}\n```\n\n### `ClientEventQuestionAnswered`\n\nAnswered, or `dismissed`: the user wrote a message instead\n\n```ts\ntype ClientEventQuestionAnswered = {\n  seq: number\n  eventId: string\n  occurredAt: string // date-time\n  blocked?: boolean\n  inputEventId?: string\n  type: \"question.answered\"\n  questionId: string\n  answers?: Array<{\n    selected: string[]\n    other?: string\n  }>\n  dismissed?: boolean\n}\n```\n"
