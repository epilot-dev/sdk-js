{
  "openapi": "3.0.2",
  "info": {
    "version": "0.1.0",
    "title": "Translation API",
    "description": "Translates short user-authored texts (workflow titles, labels) into the\nreader's language.\n\nTranslations are cached per organization, keyed by the exact source text\nand target language, so each text is sent to the translation provider\nonce. Only cache misses count toward the organization's monthly character\nbudget.\n",
    "contact": {
      "name": "epilot",
      "url": "https://docs.epilot.io"
    }
  },
  "servers": [
    {
      "url": "https://translation.sls.epilot.io"
    }
  ],
  "tags": [
    {
      "name": "Translation"
    }
  ],
  "security": [
    {
      "EpilotAuth": []
    }
  ],
  "paths": {
    "/v1/translation:translate": {
      "post": {
        "operationId": "translateTexts",
        "summary": "translateTexts",
        "description": "Translates a batch of texts into `target_language`, returning one\ntranslation per input, in the same order.\n\nThe source language is detected per text unless `source_language` is\ngiven. A text already in the target language comes back unchanged with\n`source_language` equal to `target_language`, so a client can tell an\nactual translation from a pass-through.\n",
        "x-internal": true,
        "tags": [
          "Translation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslateTextsRequest"
              },
              "example": {
                "texts": [
                  "Speicher prüfen",
                  "Erzeugungsanlage"
                ],
                "target_language": "en"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One translation per input text, in input order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslateTextsResponse"
                },
                "example": {
                  "translations": [
                    {
                      "text": "Check storage",
                      "source_language": "de"
                    },
                    {
                      "text": "Generation plant",
                      "source_language": "de"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, e.g. too many texts or an unsupported language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Translation is not enabled for the organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "The organization's (or the service's) monthly character budget is\nspent. Cached texts would have been served; at least one text needed\nthe provider.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "The translation provider failed or timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "EpilotAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization header with epilot OAuth2 bearer token",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LanguageCode": {
        "type": "string",
        "description": "ISO 639-1 language code, optionally with a region (e.g. `en`, `pt-BR`)",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
        "example": "en"
      },
      "TranslateTextsRequest": {
        "type": "object",
        "required": [
          "texts",
          "target_language"
        ],
        "properties": {
          "texts": {
            "type": "array",
            "description": "Texts to translate. Duplicates are allowed and translated once.",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "target_language": {
            "$ref": "#/components/schemas/LanguageCode"
          },
          "source_language": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LanguageCode"
              }
            ],
            "description": "Language of every text. Omit to detect it per text."
          }
        }
      },
      "TranslateTextsResponse": {
        "type": "object",
        "required": [
          "translations"
        ],
        "properties": {
          "translations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Translation"
            }
          }
        }
      },
      "Translation": {
        "type": "object",
        "required": [
          "text",
          "source_language"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "The translated text"
          },
          "source_language": {
            "type": "string",
            "description": "Language of the original text: the detected one, or\n`source_language` from the request. `und` when it could not be\ndetected.\n",
            "example": "de"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "description": "HTTP status code",
            "example": 429
          },
          "error": {
            "type": "string",
            "description": "Error message",
            "example": "Monthly translation budget exceeded"
          }
        }
      }
    }
  }
}
