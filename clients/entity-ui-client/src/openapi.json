{
  "openapi": "3.0.3",
  "info": {
    "title": "Entity UI API",
    "version": "1.0.0",
    "description": "Stores the definitions of AI widgets rendered on entity pages.\n\nA widget definition is **immutable** and **content-addressed**: its `ref` is the lowercase hex SHA-256 of the\ndefinition's RFC 8785 (JCS) canonical JSON, scoped to the organization that stored it. Storing the same\ndefinition twice returns the same `ref`. Definitions are never updated or deleted, so every schema version that\never referenced a `ref` keeps resolving it.\n\nReads act in the organization of the token, or in another organization named by `x-epilot-org-id` when the\ncaller holds an `entity:view` grant there, the way a partner reads the definitions a vendor's shared schema\nreferences. Writes act in the organization of the token only. `x-epilot-org-id` must be an organization id;\nanything else, `*` included, is a `400`.\n"
  },
  "tags": [
    {
      "name": "Widget Definitions",
      "description": "Immutable, content-addressed AI widget definitions"
    }
  ],
  "servers": [
    {
      "url": "https://entity-ui.sls.epilot.io"
    }
  ],
  "security": [
    {
      "EpilotAuth": []
    }
  ],
  "paths": {
    "/v1/entity-ui/widget-definitions": {
      "put": {
        "operationId": "putWidgetDefinition",
        "summary": "putWidgetDefinition",
        "description": "Stores a widget definition and returns its `ref`.\n\nThe server canonicalizes the body with RFC 8785 (JCS) and hashes the canonical UTF-8 bytes with SHA-256.\nStoring a definition that already exists in the organization is a no-op that returns `200` with the same\n`ref`; the stored item is never overwritten.\n\nRequires `schema:update` in the organization of the token. `x-epilot-org-id` naming another organization is\nrefused with `403`.\n",
        "tags": [
          "Widget Definitions"
        ],
        "x-epilot-permissions": [
          {
            "action": "schema:update"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WidgetDefinition"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The definition was already stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetDefinitionRefResponse"
                }
              }
            }
          },
          "201": {
            "description": "The definition was stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetDefinitionRefResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          }
        }
      }
    },
    "/v1/entity-ui/widget-definitions/{ref}": {
      "get": {
        "operationId": "getWidgetDefinition",
        "summary": "getWidgetDefinition",
        "description": "Returns a stored widget definition in its canonical form.\n\nThe response never changes for a given `ref`, so it is cacheable forever.\n\nRequires `entity:view` in the organization the request acts in: the organization of the token, or the one\nnamed by `x-epilot-org-id`, where only the roles the caller holds in that organization count. A caller with\nno `entity:view` there gets `403` whether or not the `ref` exists.\n",
        "tags": [
          "Widget Definitions"
        ],
        "x-epilot-permissions": [
          {
            "action": "entity:view"
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/WidgetDefinitionRefPathParam"
          },
          {
            "$ref": "#/components/parameters/WidgetDefinitionSchemaQueryParam"
          }
        ],
        "responses": {
          "200": {
            "description": "The widget definition",
            "headers": {
              "Cache-Control": {
                "description": "Always `private, max-age=31536000, immutable`",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "The quoted `ref`",
                "schema": {
                  "type": "string"
                }
              },
              "Vary": {
                "description": "Always `Authorization, x-epilot-org-id, x-ivy-org-id, Origin`",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetDefinition"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/entity-ui/widget-definitions/batch-get": {
      "post": {
        "operationId": "batchGetWidgetDefinitions",
        "summary": "batchGetWidgetDefinitions",
        "description": "Returns up to 20 stored widget definitions by `ref`. Refs that are not stored in the organization are\nlisted in `missing`.\n\nThe limit keeps the largest possible response under Lambda's 6MB synchronous response limit: 20 definitions\nat the 131072-byte canonical cap, with every byte escaped a second time inside the Lambda response.\n\nRequires `entity:view` in the organization the request acts in: the organization of the token, or the one\nnamed by `x-epilot-org-id`, where only the roles the caller holds in that organization count.\n",
        "tags": [
          "Widget Definitions"
        ],
        "x-epilot-permissions": [
          {
            "action": "entity:view"
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/WidgetDefinitionSchemaQueryParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchGetWidgetDefinitionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The requested definitions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchGetWidgetDefinitionsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "EpilotAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authentication using epilot OAuth2 bearer token.\nInclude the JWT token in the Authorization header: `Authorization: Bearer <token>`\n",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "WidgetDefinitionRefPathParam": {
        "name": "ref",
        "in": "path",
        "required": true,
        "description": "Lowercase hex SHA-256 of the definition's RFC 8785 canonical JSON",
        "schema": {
          "$ref": "#/components/schemas/WidgetDefinitionRef"
        }
      },
      "WidgetDefinitionSchemaQueryParam": {
        "name": "schema",
        "in": "query",
        "required": false,
        "description": "Slug of the schema whose widgets reference the requested definitions. Required when `x-epilot-org-id` names\nan organization other than the caller's: the read is then limited to refs the widgets of that schema point\nat, as entity-api returns the schema to the caller, and any other ref is a `403`. Ignored for reads in the\ncaller's own organization.\n",
        "schema": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request is malformed or fails validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid authentication",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The caller lacks the permission this operation requires",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "No definition with this ref is stored in the organization",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The canonical definition exceeds 131072 bytes",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Some definitions could not be read before the retry budget ran out, or the schema a cross-organization read\nnames could not be read from entity-api; the request can be retried\n",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "WidgetDefinitionRef": {
        "type": "string",
        "description": "Lowercase hex SHA-256 of the definition's RFC 8785 canonical JSON",
        "pattern": "^[a-f0-9]{64}$",
        "example": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      },
      "WidgetDefinitionRefResponse": {
        "type": "object",
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "$ref": "#/components/schemas/WidgetDefinitionRef"
          }
        }
      },
      "WidgetDefinition": {
        "description": "An AI widget definition, version 1 or version 2. Unknown keys are rejected at every level, because any extra\nkey would produce a different `ref` for an otherwise identical definition.\n",
        "oneOf": [
          {
            "$ref": "#/components/schemas/WidgetDefinitionV1"
          },
          {
            "$ref": "#/components/schemas/WidgetDefinitionV2"
          }
        ]
      },
      "WidgetDefinitionV1": {
        "type": "object",
        "description": "Version 1 of an AI widget definition. The widget receives every attribute of every record.",
        "additionalProperties": false,
        "required": [
          "version",
          "prompt",
          "manifest",
          "html",
          "strings"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "prompt": {
            "$ref": "#/components/schemas/WidgetPrompt"
          },
          "manifest": {
            "$ref": "#/components/schemas/WidgetManifest"
          },
          "html": {
            "$ref": "#/components/schemas/WidgetHtml"
          },
          "strings": {
            "$ref": "#/components/schemas/WidgetStrings"
          },
          "suggestions": {
            "$ref": "#/components/schemas/WidgetSuggestions"
          }
        }
      },
      "WidgetDefinitionV2": {
        "type": "object",
        "description": "Version 2 of an AI widget definition. The widget receives only the attributes its `manifest.fields` declares,\nplus `_id`, `_schema` and `_title`.\n\nAcross both string tables, the UTF-8 bytes of every key plus every value may total at most 65536 bytes. The\nserver enforces this and answers `400`; JSON Schema has no keyword to express it.\n",
        "additionalProperties": false,
        "required": [
          "version",
          "prompt",
          "manifest",
          "html",
          "strings"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              2
            ]
          },
          "prompt": {
            "$ref": "#/components/schemas/WidgetPrompt"
          },
          "manifest": {
            "$ref": "#/components/schemas/WidgetManifestV2"
          },
          "html": {
            "$ref": "#/components/schemas/WidgetHtml"
          },
          "strings": {
            "$ref": "#/components/schemas/WidgetStrings"
          },
          "suggestions": {
            "$ref": "#/components/schemas/WidgetSuggestions"
          }
        }
      },
      "WidgetPrompt": {
        "type": "string",
        "description": "The admin's own words, at most 4000 UTF-16 code units. The server counts code units and answers `400`, because\n`maxLength` counts code points, so a prompt of astral characters passes it at up to 8000 code units.\n",
        "minLength": 1,
        "maxLength": 4000
      },
      "WidgetHtml": {
        "type": "string",
        "description": "Body fragment rendered inside the sandboxed frame, at most 65536 UTF-8 bytes. The server counts bytes and\nanswers `400`, because `maxLength` counts characters.\n",
        "minLength": 1,
        "maxLength": 65536
      },
      "WidgetManifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relations",
          "libs"
        ],
        "properties": {
          "relations": {
            "$ref": "#/components/schemas/WidgetRelations"
          },
          "libs": {
            "$ref": "#/components/schemas/WidgetLibs"
          },
          "icons": {
            "$ref": "#/components/schemas/WidgetIcons"
          }
        }
      },
      "WidgetManifestV2": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relations",
          "libs",
          "fields"
        ],
        "properties": {
          "relations": {
            "$ref": "#/components/schemas/WidgetRelationsV2"
          },
          "libs": {
            "$ref": "#/components/schemas/WidgetLibs"
          },
          "icons": {
            "$ref": "#/components/schemas/WidgetIcons"
          },
          "fields": {
            "$ref": "#/components/schemas/WidgetFields"
          }
        }
      },
      "WidgetLibs": {
        "type": "array",
        "description": "Host-injected libraries, `[]` for none",
        "items": {
          "type": "string",
          "enum": [
            "echarts"
          ]
        }
      },
      "WidgetIcons": {
        "type": "array",
        "description": "Icon names the widget renders",
        "maxItems": 40,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "WidgetRelations": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "schemas",
          "size"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "none",
              "direct",
              "reverse",
              "both"
            ]
          },
          "schemas": {
            "type": "array",
            "description": "Related schemas to load; empty means every related schema, and must be empty when mode is none",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "anyOf": [
          {
            "properties": {
              "mode": {
                "enum": [
                  "direct",
                  "reverse",
                  "both"
                ]
              }
            }
          },
          {
            "properties": {
              "mode": {
                "enum": [
                  "none"
                ]
              },
              "schemas": {
                "maxItems": 0
              }
            }
          }
        ]
      },
      "WidgetRelationsV2": {
        "description": "Relations of a version 2 definition: `schemas` names every related schema to load, so it must be non-empty\nunless mode is none, and empty when mode is none.\n",
        "allOf": [
          {
            "$ref": "#/components/schemas/WidgetRelations"
          },
          {
            "anyOf": [
              {
                "properties": {
                  "mode": {
                    "enum": [
                      "none"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "schemas": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        ]
      },
      "WidgetFields": {
        "type": "object",
        "description": "Maps an entity schema slug to the top-level attributes the widget reads from records of that schema. A record\nwhose schema has no key receives `_id`, `_schema` and `_title` only.\n\nEvery key must be 1 to 128 UTF-16 code units and may not be `__proto__`, and every attribute name at most 128\nUTF-16 code units. The server enforces both and answers `400` naming the offending entry; OpenAPI 3.0 cannot\nconstrain object keys, and `maxLength` counts code points.\n",
        "maxProperties": 21,
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "WidgetStrings": {
        "type": "object",
        "description": "Localized string tables; both include `title`",
        "additionalProperties": false,
        "required": [
          "de",
          "en"
        ],
        "properties": {
          "de": {
            "$ref": "#/components/schemas/WidgetStringTable"
          },
          "en": {
            "$ref": "#/components/schemas/WidgetStringTable"
          }
        }
      },
      "WidgetStringTable": {
        "type": "object",
        "description": "String table of one locale. Keys are what the widget passes to `t()`; both tables include `title`.\n\nEvery key must match `^[a-z0-9_]{1,64}$` (snake_case, at most 64 characters) and may not be `__proto__`. The\nserver enforces this and answers `400` naming the offending key; OpenAPI 3.0 has no keyword to express it.\n",
        "required": [
          "title"
        ],
        "maxProperties": 200,
        "additionalProperties": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "WidgetSuggestions": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "de",
          "en"
        ],
        "properties": {
          "de": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            }
          },
          "en": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BatchGetWidgetDefinitionsRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refs"
        ],
        "properties": {
          "refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/WidgetDefinitionRef"
            }
          }
        }
      },
      "BatchGetWidgetDefinitionsResponse": {
        "type": "object",
        "required": [
          "definitions",
          "missing"
        ],
        "properties": {
          "definitions": {
            "type": "object",
            "description": "Stored definitions keyed by ref",
            "additionalProperties": {
              "$ref": "#/components/schemas/WidgetDefinition"
            }
          },
          "missing": {
            "type": "array",
            "description": "Requested refs that are not stored in the organization",
            "items": {
              "$ref": "#/components/schemas/WidgetDefinitionRef"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error response format for all API errors",
        "required": [
          "error",
          "status"
        ],
        "properties": {
          "error": {
            "description": "Error message, or the list of validation errors for a 400",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code of the error"
          }
        }
      }
    }
  }
}
