{
  "openapi": "3.0.3",
  "info": {
    "title": "Purpose API",
    "version": "1.0.0",
    "description": "The Purpose API manages epilot **Purposes** – a special system taxonomy used to tag and organize resources across the platform (entities, attributes, groups, automations, templates, and more).\n\nPurposes control what information is visible in the epilot 360 UI depending on the task a user is performing. For example, tagging an entity attribute with the \"Electricity Contract\" purpose means that attribute is shown only in electricity-related workflows and hidden elsewhere.\n\n**Key concepts**\n\n- **Purpose** – A named label (UUID + name) that can be attached to any epilot resource.\n- **Tagging** – Resources are tagged by storing purpose IDs in a `_purposes` array field. Hydrate them with `batchGetPurposes`.\n- **Discovery** – Use `searchPurposes` to find purposes by name for autocomplete UIs or user-driven selection.\n",
    "contact": {
      "name": "Support",
      "email": "info@epilot.cloud",
      "url": "https://help.epilot.cloud"
    }
  },
  "tags": [
    {
      "name": "Purpose",
      "description": "CRUD operations and search for epilot Purposes.\n\nPurposes are system-level taxonomy entries that drive conditional visibility of entities, attributes, and UI components in epilot 360. They are referenced by UUID across the platform and resolved to full objects on demand.\n\n**Typical flows**\n\n- **Create** a new purpose for a product line or business domain.\n- **Search** purposes to populate autocomplete / picker components in the UI.\n- **Batch-get** purposes when hydrating `_purposes` arrays on entities.\n- **Update** or **delete** purposes as business requirements evolve.\n"
    },
    {
      "name": "purpose_schema",
      "x-displayName": "Purpose",
      "description": "<SchemaDefinition schemaRef=\"#/components/schemas/Purpose\" />\n"
    }
  ],
  "x-tagGroups": [
    {
      "name": "APIs",
      "tags": [
        "Purpose"
      ]
    },
    {
      "name": "Schemas",
      "tags": [
        "purpose_schema"
      ]
    }
  ],
  "security": [
    {
      "EpilotAuth": []
    },
    {
      "EpilotOrg": []
    }
  ],
  "paths": {
    "/v1/purpose": {
      "post": {
        "operationId": "createPurpose",
        "x-epilot-permissions": [
          {
            "action": "label_builder:create"
          }
        ],
        "summary": "createPurpose",
        "description": "Create a new purpose.\n\nPurpose names must be unique within an organization. Attempting to create a purpose with a name that already exists returns `409 Conflict`.\n",
        "tags": [
          "Purpose"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CreatePurposeRequest"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/PurposeResponse"
          },
          "400": {
            "$ref": "#/components/responses/ClientErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponse"
          },
          "409": {
            "$ref": "#/components/responses/ConflictResponse"
          },
          "500": {
            "$ref": "#/components/responses/ServerErrorResponse"
          }
        }
      }
    },
    "/v1/purpose:search": {
      "get": {
        "operationId": "searchPurposes",
        "x-epilot-permissions": [
          {
            "access": "org"
          }
        ],
        "summary": "searchPurposes",
        "description": "Search purposes using fuzzy matching against the purpose name.\n\nUse this endpoint for autocomplete inputs and user-driven purpose pickers. For resolving known purpose IDs to full objects, use `batchGetPurposes` instead.\n",
        "tags": [
          "Purpose"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/QueryParam"
          },
          {
            "$ref": "#/components/parameters/SizeParam"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/PurposeSearchResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "500": {
            "$ref": "#/components/responses/ServerErrorResponse"
          }
        }
      }
    },
    "/v1/purpose:batchGet": {
      "post": {
        "operationId": "batchGetPurposes",
        "x-epilot-permissions": [
          {
            "access": "org"
          }
        ],
        "summary": "batchGetPurposes",
        "description": "Fetch multiple purposes by their known IDs in a single request.\n\n**Use this for:**\n- Hydrating purpose references from entities\n- Resolving a list of purpose IDs to full objects\n\n**Do NOT use this for:**\n- Browsing/discovering purposes (use `searchPurposes` instead)\n- Autocomplete (use `searchPurposes` instead)\n\n**Examples:**\n- Entity has `_purposes: [\"uuid-1\", \"uuid-2\"]` → fetch full purpose objects\n- Display purpose names for a list of tagged entities\n",
        "tags": [
          "Purpose"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/BatchGetPurposesRequest"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PurposeListResponse"
          },
          "400": {
            "$ref": "#/components/responses/ClientErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "500": {
            "$ref": "#/components/responses/ServerErrorResponse"
          }
        }
      }
    },
    "/v1/purpose/{purposeId}": {
      "get": {
        "operationId": "getPurpose",
        "x-epilot-permissions": [
          {
            "access": "org"
          }
        ],
        "summary": "getPurpose",
        "description": "Get a single purpose by its UUID.",
        "tags": [
          "Purpose"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PurposeIdPathParam"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/PurposeResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundResponse"
          },
          "500": {
            "$ref": "#/components/responses/ServerErrorResponse"
          }
        }
      },
      "put": {
        "operationId": "updatePurpose",
        "x-epilot-permissions": [
          {
            "action": "label_builder:edit"
          }
        ],
        "summary": "updatePurpose",
        "description": "Update an existing purpose.\n\nOnly the `name` field can be updated. The `id`, `created_at`, and `updated_at` fields are managed by the server.\n",
        "tags": [
          "Purpose"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PurposeIdPathParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/UpdatePurposeRequest"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PurposeResponse"
          },
          "400": {
            "$ref": "#/components/responses/ClientErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponse"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundResponse"
          },
          "500": {
            "$ref": "#/components/responses/ServerErrorResponse"
          }
        }
      },
      "delete": {
        "operationId": "deletePurpose",
        "x-epilot-permissions": [
          {
            "action": "label_builder:delete"
          }
        ],
        "summary": "deletePurpose",
        "description": "Permanently delete a purpose by its UUID.\n\nDeleting a purpose does not automatically remove it from resources that reference it. Clients should handle stale purpose IDs gracefully.\n",
        "tags": [
          "Purpose"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PurposeIdPathParam"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/PurposeResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponse"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundResponse"
          },
          "500": {
            "$ref": "#/components/responses/ServerErrorResponse"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "EpilotAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Epilot Bearer token"
      },
      "EpilotOrg": {
        "type": "apiKey",
        "in": "header",
        "name": "x-epilot-org-id",
        "description": "Epilot Organization ID"
      }
    },
    "parameters": {
      "PurposeIdPathParam": {
        "name": "purposeId",
        "in": "path",
        "required": true,
        "description": "Purpose ID (UUID)",
        "schema": {
          "type": "string"
        },
        "example": "1fdc8f66-0e2b-4e20-a347-9cbdbf6a7217"
      },
      "QueryParam": {
        "name": "query",
        "in": "query",
        "required": false,
        "description": "Fuzzy search query string matched against the purpose name",
        "schema": {
          "type": "string"
        },
        "example": "electricity"
      },
      "SizeParam": {
        "name": "size",
        "in": "query",
        "required": false,
        "description": "Maximum number of results to return",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      }
    },
    "schemas": {
      "Purpose": {
        "type": "object",
        "description": "An epilot Purpose – a named taxonomy label used to tag and organize resources across the platform",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the purpose",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name of the purpose",
            "example": "Electricity Contract"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of when the purpose was created",
            "example": "2024-01-15T10:30:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the last update",
            "example": "2024-06-01T08:00:00.000Z"
          }
        }
      },
      "CreatePurposeInput": {
        "type": "object",
        "description": "Input for creating a new purpose",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable name for the purpose. Must be unique within the organization.",
            "example": "Electricity Contract"
          }
        },
        "example": {
          "name": "Electricity Contract"
        }
      },
      "UpdatePurposeInput": {
        "type": "object",
        "description": "Input for updating an existing purpose",
        "properties": {
          "name": {
            "type": "string",
            "description": "New human-readable name for the purpose",
            "example": "Electricity & Gas Contract"
          }
        },
        "example": {
          "name": "Electricity & Gas Contract"
        }
      },
      "BatchGetPurposesInput": {
        "type": "object",
        "description": "Input for batch-fetching purposes by their IDs",
        "required": [
          "purposeIds"
        ],
        "properties": {
          "purposeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "List of purpose UUIDs to fetch",
            "example": [
              "123e4567-e89b-12d3-a456-426614174000",
              "987fcdeb-51a2-43f7-9012-345678901234"
            ]
          }
        },
        "example": {
          "purposeIds": [
            "123e4567-e89b-12d3-a456-426614174000",
            "987fcdeb-51a2-43f7-9012-345678901234"
          ]
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "HTTP status code",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Short error label",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "description": "Human-readable description of the error",
            "example": "name is a required field"
          }
        }
      }
    },
    "requestBodies": {
      "CreatePurposeRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CreatePurposeInput"
            },
            "example": {
              "name": "Electricity Contract"
            }
          }
        }
      },
      "UpdatePurposeRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpdatePurposeInput"
            },
            "example": {
              "name": "Electricity & Gas Contract"
            }
          }
        }
      },
      "BatchGetPurposesRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BatchGetPurposesInput"
            },
            "example": {
              "purposeIds": [
                "123e4567-e89b-12d3-a456-426614174000",
                "987fcdeb-51a2-43f7-9012-345678901234"
              ]
            }
          }
        }
      }
    },
    "responses": {
      "PurposeResponse": {
        "description": "Single purpose object",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Purpose"
            },
            "example": {
              "id": "123e4567-e89b-12d3-a456-426614174000",
              "name": "Electricity Contract",
              "created_at": "2024-01-15T10:30:00.000Z",
              "updated_at": "2024-06-01T08:00:00.000Z"
            }
          }
        }
      },
      "PurposeListResponse": {
        "description": "List of purposes matching the requested IDs",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "results": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Purpose"
                  }
                },
                "hits": {
                  "type": "integer",
                  "description": "Total number of results returned",
                  "example": 2
                }
              }
            },
            "example": {
              "hits": 2,
              "results": [
                {
                  "id": "123e4567-e89b-12d3-a456-426614174000",
                  "name": "Electricity Contract",
                  "created_at": "2024-01-15T10:30:00.000Z",
                  "updated_at": "2024-06-01T08:00:00.000Z"
                },
                {
                  "id": "987fcdeb-51a2-43f7-9012-345678901234",
                  "name": "Gas Contract",
                  "created_at": "2024-02-01T09:00:00.000Z",
                  "updated_at": "2024-05-15T12:00:00.000Z"
                }
              ]
            }
          }
        }
      },
      "PurposeSearchResponse": {
        "description": "Search results matching the query",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "results": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Purpose"
                  }
                }
              }
            },
            "example": {
              "results": [
                {
                  "id": "123e4567-e89b-12d3-a456-426614174000",
                  "name": "Electricity Contract",
                  "created_at": "2024-01-15T10:30:00.000Z",
                  "updated_at": "2024-06-01T08:00:00.000Z"
                }
              ]
            }
          }
        }
      },
      "ClientErrorResponse": {
        "description": "Bad request – invalid or missing parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": 400,
              "error": "Bad Request",
              "message": "name is a required field"
            }
          }
        }
      },
      "UnauthorizedResponse": {
        "description": "Unauthorized – missing or invalid authentication credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": 401,
              "error": "Unauthorized",
              "message": "Missing or invalid authorization token"
            }
          }
        }
      },
      "ForbiddenResponse": {
        "description": "Forbidden – caller does not have permission to perform this action",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": 403,
              "error": "Forbidden",
              "message": "Insufficient permissions to manage purposes"
            }
          }
        }
      },
      "NotFoundResponse": {
        "description": "Not found – the requested purpose does not exist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": 404,
              "error": "Not Found",
              "message": "Purpose with ID '1fdc8f66-0e2b-4e20-a347-9cbdbf6a7217' not found"
            }
          }
        }
      },
      "ConflictResponse": {
        "description": "Conflict – a purpose with this name already exists in the organization",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": 409,
              "error": "Conflict",
              "message": "A purpose named 'Electricity Contract' already exists"
            }
          }
        }
      },
      "ServerErrorResponse": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": 500,
              "error": "Internal Server Error",
              "message": "An unexpected error occurred"
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://purpose.sls.epilot.io"
    }
  ]
}
