{
  "openapi": "3.0.3",
  "info": {
    "title": "Phone Integration API",
    "description": "Connects epilot to phone systems. Resolves the epilot customers (Contacts)\nbehind phone numbers and other contact identifiers, many at once, so the\nepilot 360 phone can show callers and call history by name.\n",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "phone-integration",
      "description": "Phone Integration"
    },
    {
      "name": "manager",
      "description": "Phone manager (epilot 360 control center): which organization members hold the phone and the\ntelephony-provider user behind each of them. Caller must hold `phone:manage` in the organization.\n"
    },
    {
      "name": "operator",
      "description": "Provider setup per organization, run by epilot CS from the admin portal. Platform operators only\n(admin-portal internal-auth token in an allowed group), never customer tokens.\n"
    }
  ],
  "servers": [
    {
      "url": "https://phone-integration-api.sls.epilot.io"
    }
  ],
  "security": [
    {
      "EpilotAuth": []
    }
  ],
  "paths": {
    "/v1/customer:batchSearch": {
      "get": {
        "operationId": "batchSearchCustomers",
        "summary": "batchSearchCustomers",
        "description": "Resolves up to 50 identifiers to epilot customers (Contacts) in one\nrequest — for example every number in an agent's call history.\n\nEach identifier is an exact key of a Contact: its entity `id`, its\n`customer_number`, its `external_id`, one of its `email` addresses or\none of its `phone` numbers. Repeat a parameter to pass several values,\nand combine parameters freely. Phone numbers are normalized on the\nserver, so E.164, national and formatted forms of one number match the\nsame contact; the other identifiers match exactly, ignoring case and\nsurrounding whitespace.\n\nEvery distinct identifier gets its own result, so one unknown or\nambiguous identifier never fails the others. Results are ordered by\nparameter (`id`, `customer_number`, `external_id`, `phone_number`,\n`email`), then as sent; match them by `identifier`.\n\nThe search runs with the caller's token: the organization and the\npermissions applied are the caller's own, as for entity search.\n",
        "tags": [
          "phone-integration"
        ],
        "security": [
          {
            "EpilotAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Contact entity id",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": [
              "dba8e5f9-8b3f-4608-b887-cd0798fce624"
            ]
          },
          {
            "name": "customer_number",
            "in": "query",
            "required": false,
            "description": "Contact customer number",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": [
              "4711"
            ]
          },
          {
            "name": "external_id",
            "in": "query",
            "required": false,
            "description": "Contact external id, as set by an integration",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": [
              "crm-000123"
            ]
          },
          {
            "name": "phone_number",
            "in": "query",
            "required": false,
            "description": "Phone number in E.164 (+4917…), national (017…) or a formatted form",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": [
              "+4917012345678",
              "030 1234567"
            ]
          },
          {
            "name": "email",
            "in": "query",
            "required": false,
            "description": "Email address",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": [
              "max.mustermann@example.com"
            ]
          },
          {
            "name": "x-trace-id",
            "in": "header",
            "required": false,
            "description": "Correlation id; echoed on the response",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One result per distinct identifier",
            "headers": {
              "x-trace-id": {
                "description": "Correlation id (echoed if supplied, otherwise generated)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerBatchSearchResult"
                }
              }
            }
          },
          "400": {
            "description": "No identifier, more than 50, or a blank one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or downstream-rejected epilot bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not permitted to search Contacts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/manager/status": {
      "get": {
        "operationId": "getManagerStatus",
        "summary": "getManagerStatus",
        "description": "Whether the caller's organization is ready for phone agents: the telephony provider tenant\nexists and is configured. The control center shows a \"not set up\" state when `ready` is false.\nRequires `phone:manage`.\n",
        "tags": [
          "manager"
        ],
        "security": [
          {
            "EpilotAuth": []
          }
        ],
        "x-epilot-permissions": [
          "phone:manage"
        ],
        "responses": {
          "200": {
            "description": "Readiness of the organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagerStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/manager/agents": {
      "get": {
        "operationId": "listPhoneAgents",
        "summary": "listPhoneAgents",
        "description": "Organization members who hold the phone (`phone:use`), each joined with the provider user behind\nthem. Requires `phone:manage`.\n",
        "tags": [
          "manager"
        ],
        "security": [
          {
            "EpilotAuth": []
          }
        ],
        "x-epilot-permissions": [
          "phone:manage"
        ],
        "responses": {
          "200": {
            "description": "The organization's phone agents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "results"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PhoneAgent"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      },
      "post": {
        "operationId": "assignPhoneAgent",
        "summary": "assignPhoneAgent",
        "description": "Gives an organization member the phone. In order: the member is verified with user-api, their\npairwise subject for the provider is read from identity-api, the provider user is created (or\nfound) bound to that subject with the `agent` role, and only then the `phone_agent` role\n(`phone:use`) is assigned in epilot. Idempotent: an already assigned member answers `200`.\nRequires `phone:manage`.\n",
        "tags": [
          "manager"
        ],
        "security": [
          {
            "EpilotAuth": []
          }
        ],
        "x-epilot-permissions": [
          "phone:manage"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignPhoneAgentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The member already held the phone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneAgent"
                }
              }
            }
          },
          "201": {
            "description": "The member now holds the phone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneAgent"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "The user is not an active member of the organization (code `member_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The member cannot get the phone yet; `code` says why:\n- `not_set_up`: the organization is not set up for the phone (see getManagerStatus);\n- `identity_subject_unavailable`: identity-api cannot issue the member's subject (organization\n  not enabled on the identity client, or the user is not an active member there);\n- `identity_client_unavailable`: the identity client the setup points at is not active;\n- `provider_conflict`: the provider refused, e.g. this person's identity is bound to another\n  provider user.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    },
    "/v1/manager/agents/{user_id}": {
      "parameters": [
        {
          "name": "user_id",
          "in": "path",
          "required": true,
          "description": "epilot user id (`custom:ivy_user_id`)",
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "delete": {
        "operationId": "removePhoneAgent",
        "summary": "removePhoneAgent",
        "description": "Takes the phone away from a member: the `phone_agent` role is removed first, then the provider\nuser is deactivated (never deleted: call history keeps referring to it). Requires `phone:manage`.\n",
        "tags": [
          "manager"
        ],
        "security": [
          {
            "EpilotAuth": []
          }
        ],
        "x-epilot-permissions": [
          "phone:manage"
        ],
        "responses": {
          "204": {
            "description": "The member no longer holds the phone"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "The member does not hold the phone (code `agent_not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The role was removed but the provider user could not be deactivated (code `provider_error`);\nremoving again retries the deactivation.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/operator/provider-setups": {
      "get": {
        "operationId": "listProviderSetups",
        "summary": "listProviderSetups",
        "description": "Every organization that has a telephony provider tenant, for the admin portal's overview: the\nprovider's sub-accounts (one per organization, keyed by the organization id) joined with this\nservice's setup record. `ready` follows getManagerStatus: an organization whose tenant was created\nby hand, outside `setupProvider`, has no record and is not ready until the setup runs once.\nSorted by organization id; not paged (one tenant per organization, a few hundred at most).\n",
        "tags": [
          "operator"
        ],
        "security": [
          {
            "OperatorAuth": []
          }
        ],
        "x-epilot-permissions": [
          "internal"
        ],
        "responses": {
          "200": {
            "description": "The provider setups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "results"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProviderSetupSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/operator/organizations/{org_id}/provider": {
      "parameters": [
        {
          "name": "org_id",
          "in": "path",
          "required": true,
          "description": "epilot organization id",
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "get": {
        "operationId": "getProviderSetup",
        "summary": "getProviderSetup",
        "description": "What has been set up at the telephony provider for this organization.",
        "tags": [
          "operator"
        ],
        "security": [
          {
            "OperatorAuth": []
          }
        ],
        "x-epilot-permissions": [
          "internal"
        ],
        "responses": {
          "200": {
            "description": "Provider setup state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderSetup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/operator/organizations/{org_id}/provider:setup": {
      "parameters": [
        {
          "name": "org_id",
          "in": "path",
          "required": true,
          "description": "epilot organization id",
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      ],
      "post": {
        "operationId": "setupProvider",
        "summary": "setupProvider",
        "description": "Prepares the telephony provider for an organization, idempotently and in order: the provider\ntenant (Babelforce sub-account keyed by the organization id), its SCIM configuration with role\nmanagement on, and its SSO configuration pointing at the identity-api client given here. The\nclient secret is forwarded to the provider and never stored by this service. Re-running updates\nthe SSO configuration (new client or rotated secret) and leaves the rest untouched.\n",
        "tags": [
          "operator"
        ],
        "security": [
          {
            "OperatorAuth": []
          }
        ],
        "x-epilot-permissions": [
          "internal"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderSetupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider setup state after the run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderSetup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "The provider refused, for example the account name is taken (code `provider_conflict`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "The request is malformed or fails validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The caller lacks the required permission",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "BadGateway": {
        "description": "A dependency failed: the telephony provider could not be reached or answered unexpectedly (code\n`provider_error`, with the provider's request id when it sent one), or identity-api is\ntemporarily unavailable (code `identity_unavailable`). Retrying is safe.\n",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "The operator's admin-portal groups could not be checked right now; retry",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "EpilotAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "OperatorAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Internal-auth bearer token minted for an epilot admin-portal user in an allowed group (same\npolicy as identity-api's operator API). Customer organization bearers are never accepted.\n"
      }
    },
    "schemas": {
      "ManagerStatus": {
        "type": "object",
        "required": [
          "provider",
          "ready",
          "reasons"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "description": "Telephony provider behind this organization",
            "enum": [
              "babelforce"
            ]
          },
          "ready": {
            "type": "boolean",
            "description": "Agents can be assigned"
          },
          "reasons": {
            "type": "array",
            "description": "Why the organization is not ready (empty when ready)",
            "items": {
              "type": "string",
              "enum": [
                "provider_tenant_missing",
                "sso_not_configured",
                "scim_not_configured",
                "identity_enablement_missing"
              ]
            }
          }
        }
      },
      "PhoneAgent": {
        "type": "object",
        "required": [
          "user_id",
          "email",
          "status"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "description": "epilot user id"
          },
          "email": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "`active`: holds the phone and has an enabled provider user. `pending`: assigned in epilot but\nthe provider user is not activated yet. `disabled`: provider user disabled. `missing_provider`:\nholds `phone:use` but no provider user is bound (assign again to repair). `missing_role`:\nassigned here, but the `phone_agent` role (`phone:use`) was removed elsewhere, e.g. in the\nusers and permissions settings (assign again to restore it, or remove to deactivate the\nprovider user).\n",
            "enum": [
              "active",
              "pending",
              "disabled",
              "missing_provider",
              "missing_role"
            ]
          },
          "provider_user_id": {
            "type": "string",
            "description": "The provider's id of the bound user"
          },
          "provider_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assigned_at": {
            "type": "string",
            "format": "date-time"
          },
          "assigned_by": {
            "type": "string",
            "description": "epilot user id of the manager who assigned the phone"
          }
        }
      },
      "AssignPhoneAgentRequest": {
        "type": "object",
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "description": "epilot user id of an active member of the caller's organization",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "ProviderSetup": {
        "type": "object",
        "required": [
          "provider",
          "org_id",
          "ready",
          "tenant",
          "scim",
          "sso"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "babelforce"
            ]
          },
          "org_id": {
            "type": "string"
          },
          "ready": {
            "type": "boolean",
            "description": "Everything below is in place"
          },
          "tenant": {
            "type": "object",
            "description": "The provider tenant for this organization (null until created)",
            "nullable": true,
            "required": [
              "id",
              "name",
              "org_key"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "org_key": {
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "scim": {
            "type": "object",
            "required": [
              "configured",
              "roles_enabled"
            ],
            "properties": {
              "configured": {
                "type": "boolean"
              },
              "roles_enabled": {
                "type": "boolean"
              }
            }
          },
          "sso": {
            "type": "object",
            "required": [
              "configured"
            ],
            "properties": {
              "configured": {
                "type": "boolean"
              },
              "identity_client_id": {
                "type": "string",
                "description": "The identity-api client the tenant's SSO configuration points at"
              },
              "configured_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "last_setup_by": {
            "type": "string",
            "description": "Admin-portal operator (email) who last ran the setup"
          }
        }
      },
      "ProviderSetupSummary": {
        "type": "object",
        "description": "One organization's provider setup, as listed in the overview (no live SCIM or SSO reads).",
        "required": [
          "org_id",
          "provider",
          "ready",
          "setup_recorded",
          "tenant"
        ],
        "properties": {
          "org_id": {
            "type": "string",
            "description": "epilot organization id (the provider tenant's org key)"
          },
          "provider": {
            "type": "string",
            "enum": [
              "babelforce"
            ]
          },
          "ready": {
            "type": "boolean",
            "description": "Phone agents can be assigned (same rule as getManagerStatus)"
          },
          "setup_recorded": {
            "type": "boolean",
            "description": "`setupProvider` has run for this organization at least once. `false` for a tenant created by\nhand at the provider: run the setup once to record it.\n"
          },
          "tenant": {
            "type": "object",
            "required": [
              "id",
              "name",
              "org_key"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "The provider's tenant id (Babelforce sub-account id)"
              },
              "name": {
                "type": "string"
              },
              "org_key": {
                "type": "string"
              }
            }
          },
          "sso_identity_client_id": {
            "type": "string",
            "description": "The identity-api client the recorded SSO configuration points at"
          },
          "last_setup_by": {
            "type": "string",
            "description": "The operator who last ran the setup (email)"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the setup record last changed"
          }
        }
      },
      "ProviderSetupRequest": {
        "type": "object",
        "required": [
          "identity_client_id",
          "identity_client_secret"
        ],
        "properties": {
          "account_name": {
            "type": "string",
            "description": "Provider tenant name, unique across the provider (3 to 100 characters). Required the first\ntime (`400` with code `account_name_required` without it); ignored once the tenant exists.\n",
            "minLength": 3,
            "maxLength": 100
          },
          "identity_client_id": {
            "type": "string",
            "description": "identity-api client registered for the provider (its partner application for this stage)",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "identity_client_secret": {
            "type": "string",
            "description": "The client's current secret, forwarded to the provider's SSO configuration and never stored",
            "minLength": 12,
            "maxLength": 512
          }
        }
      },
      "CustomerBatchSearchResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "description": "One result per distinct identifier",
            "items": {
              "$ref": "#/components/schemas/CustomerSearchResult"
            }
          }
        }
      },
      "CustomerSearchResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "status"
        ],
        "properties": {
          "identifier": {
            "$ref": "#/components/schemas/CustomerIdentifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "found",
              "not_found",
              "ambiguous",
              "invalid",
              "error"
            ],
            "description": "- `found` — exactly one contact has the identifier; see `customer`\n- `not_found` — no contact the caller may see has it\n- `ambiguous` — several contacts share it; none is chosen\n- `invalid` — not a usable identifier (a phone number that does\n  not parse), so nothing was searched\n- `error` — the search for this identifier failed; try again\n"
          },
          "customer": {
            "$ref": "#/components/schemas/CustomerSummary"
          }
        }
      },
      "CustomerIdentifier": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "id",
              "customer_number",
              "external_id",
              "phone_number",
              "email"
            ]
          },
          "value": {
            "type": "string",
            "description": "The identifier as sent",
            "example": "+4917012345678"
          }
        }
      },
      "CustomerSummary": {
        "type": "object",
        "additionalProperties": false,
        "description": "Present when `status` is `found`",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "epilot entity id of the customer (Contact)",
            "example": "dba8e5f9-8b3f-4608-b887-cd0798fce624"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "The contact's title, else its first and last name; null when it has neither",
            "example": "Max Mustermann"
          },
          "customer_number": {
            "type": "string",
            "description": "Omitted when the contact has none",
            "example": "4711"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "description": "HTTP status code."
          },
          "error": {
            "type": "string",
            "description": "Human-readable error message."
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code, when the operation defines one."
          }
        }
      }
    }
  }
}
